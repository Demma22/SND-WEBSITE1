---
// Shared site header — used on every page for a single, consistent nav.
// Props:
//   homepage : when true, section links are in-page anchors (#work);
//              otherwise they point back to the home page (/#work).
//   active   : label of the current section to highlight (e.g. "Journal").
interface Props {
  homepage?: boolean;
  active?: string;
}
const { homepage = false, active = '' } = Astro.props;

const items = [
  { label: 'The Craft', anchor: '#work' },
  { label: 'Art', href: '/art' },
  { label: 'Products', href: '/products' },
  { label: 'About',    anchor: '#studio' },
  { label: 'Inside Stories', href: '/inside-stories' },
  { label: 'Contact',  anchor: '#contact' },
];

const resolve = (item: { anchor?: string; href?: string }) =>
  item.href ?? (homepage ? item.anchor! : `/${item.anchor}`);
---

<a href="#main" class="skip-link">Skip to content</a>

<header class="site-header" id="siteHeader">
  <div class="container header-inner">
    <a href="/" class="logo-link" aria-label="SND — home">
      <img src="/snd.png" alt="SND" class="logo-img" />
    </a>
    <nav class="nav-links" aria-label="Primary">
      {items.map((item) => (
        <a
          href={resolve(item)}
          class:list={['nav-link', { 'is-active': item.label === active }]}
          aria-current={item.label === active ? 'page' : undefined}
        >{item.label}</a>
      ))}
    </nav>
    <div class="nav-actions">
      <a href={homepage ? '#contact' : '/#contact'} class="btn btn--dark btn--small">Join community</a>
      <button class="nav-toggle" id="navToggle" aria-label="Open menu" aria-expanded="false" aria-controls="mobileNav">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<nav class="mobile-nav" id="mobileNav" aria-label="Mobile">
  {items.map((item) => (
    <a href={resolve(item)} aria-current={item.label === active ? 'page' : undefined}>{item.label}</a>
  ))}
</nav>

<script>
  /* This module runs ONCE per hard load; with the ClientRouter, page bodies
     are swapped on navigation. So: persistent window/document listeners are
     registered here exactly once and delegate to per-page state, while
     init() re-binds fresh elements on every `astro:page-load`. */

  let header: HTMLElement | null = null;
  let dotHosts: NodeListOf<Element> | [] = [];
  let setMenuRef: (open: boolean) => void = () => {};

  /* Single rAF-throttled scroll pass — header shadow + dot-grid parallax
     together, one layout read/write per frame. (background-attachment: fixed
     is ignored on mobile, so --dotY counters the scroll position instead.) */
  /* The dot pattern repeats every 8rem, so translating by (top % period)
     is visually identical to the full offset — the composited layer only
     needs an 8rem bleed, and scrolling never repaints (transform-only). */
  const DOT_PERIOD = 8 * (parseFloat(getComputedStyle(document.documentElement).fontSize) || 16);
  let tick = false;
  const onFrame = () => {
    header?.classList.toggle('is-scrolled', window.scrollY > 20);
    // Read phase (all layouts first), then write phase — no interleaved thrash
    const offsets: number[] = [];
    dotHosts.forEach((el) => {
      offsets.push(-(el.getBoundingClientRect().top % DOT_PERIOD));
    });
    dotHosts.forEach((el, i) => {
      (el as HTMLElement).style.setProperty('--dotY', `${offsets[i]}px`);
    });
    tick = false;
  };
  const onScroll = () => { if (!tick) { tick = true; requestAnimationFrame(onFrame); } };
  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll, { passive: true });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setMenuRef(false);
  });

  function init() {
    header = document.getElementById('siteHeader');
    const toggle = document.getElementById('navToggle');
    const mobileNav = document.getElementById('mobileNav');

    const setMenu = (open: boolean) => {
      toggle?.classList.toggle('is-open', open);
      mobileNav?.classList.toggle('is-open', open);
      toggle?.setAttribute('aria-expanded', String(open));
      // Freeze the page while the menu sheet is open
      document.body.style.overflow = open ? 'hidden' : '';
    };
    setMenuRef = setMenu;
    toggle?.addEventListener('click', () => {
      setMenu(!mobileNav?.classList.contains('is-open'));
    });
    mobileNav?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMenu(false)));

    dotHosts = document.querySelectorAll(
      '.hero, .feature-strip, .studio, .cta, .stories-strip, .legal-hero, .stories-hero, .page-hero, .post-stripe, .art-hero'
    );
    onFrame();

    /* Scroll reveal — global so every page's `.reveal` elements animate in.
       - Trigger line at 88% of the viewport (threshold 0 + rootMargin) so tall
         blocks reveal the moment they arrive, not after 10% of their height.
       - If the intro loader is up, wait for its fade to start so the entrance
         plays in front of the user instead of hidden behind the overlay. */
    const revealEls = document.querySelectorAll('.reveal');
    if (revealEls.length) {
      const startReveals = () => {
        const ro = new IntersectionObserver((entries, obs) => {
          entries.forEach((entry, i) => {
            if (entry.isIntersecting) {
              const el = entry.target as HTMLElement;
              setTimeout(() => el.classList.add('is-visible'), (i % 5) * 60);
              obs.unobserve(el);
            }
          });
        }, { threshold: 0, rootMargin: '0px 0px -12% 0px' });
        revealEls.forEach((el) => ro.observe(el));
      };
      if (document.documentElement.classList.contains('intro-active')) {
        let started = false;
        const once = () => { if (!started) { started = true; startReveals(); } };
        document.addEventListener('snd:intro-done', once, { once: true });
        setTimeout(once, 4000); // safety: never leave content hidden
      } else {
        startReveals();
      }
    }
  }

  // Fires on the initial load AND after every client-side navigation.
  document.addEventListener('astro:page-load', init);
</script>
