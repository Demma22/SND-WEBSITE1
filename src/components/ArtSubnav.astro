---
/**
 * Sub-navigation for the art section. The main header keeps a single "Art"
 * link; this row carries the collections beneath it.
 */
interface Props {
  /** Label of the current page, e.g. "Originals". */
  active?: string;
  /** Render on a dark surface. */
  light?: boolean;
}
const { active = '', light = false } = Astro.props;

const items = [
  { label: 'Overview', href: '/art' },
  { label: 'Gallery', href: '/art/gallery' },
  { label: 'Originals', href: '/art/originals' },
  { label: 'Prints', href: '/art/prints' },
  { label: 'Commissions', href: '/art/commissions' },
];
---

<nav class:list={['art-subnav', { 'art-subnav--light': light }]} aria-label="Art collections">
  {items.map((item) => (
    <a
      href={item.href}
      class:list={['art-subnav-link', { 'is-active': item.label === active }]}
      aria-current={item.label === active ? 'page' : undefined}
    >{item.label}</a>
  ))}
</nav>
