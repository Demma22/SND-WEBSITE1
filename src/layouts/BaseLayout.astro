---
// Base Layout Component - Only handles HTML structure, favicons, and title
// Place at: src/layouts/BaseLayout.astro

export interface Props {
  title: string;
  description?: string;
}

const { title, description = "SND Studio — Think It, Let's Create It" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="description" content={description} />
  
  <!-- Theme color - changes with scroll to match navbar -->
  <meta name="theme-color" id="themeColor" content="#ffffff" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" id="statusBarStyle" content="default" />
  
  <!-- Favicons -->
  <link rel="icon" type="image/svg+xml" href="/favicon.png" />
  <link rel="icon" type="image/png" sizes="32x32" href="/SND1.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/SND1.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  
  <title>{title}</title>
  
  <style>
    /* Global reset - remove all default margins and padding */
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    
    body {
      margin: 0;
      padding: 0;
      width: 100%;
      overflow-x: hidden;
      overflow-y: auto;
      position: relative;
    }
    
    html {
      overflow-x: hidden;
      width: 100%;
      position: relative;
    }
    
    /* Status bar spacer - ensures content doesn't go under status bar */
    body::before {
      content: '';
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      height: env(safe-area-inset-top, 0px);
      background: transparent;
      z-index: 1001;
      pointer-events: none;
    }
  </style>
</head>
<body>
  <slot />
  
  <script>
    // Update theme color based on scroll to match navbar
    const themeColorMeta = document.getElementById('themeColor');
    const statusBarStyle = document.getElementById('statusBarStyle');
    
    const updateThemeColor = () => {
      if (window.scrollY > 30) {
        // When scrolled - black/dark status bar to match black navbar
        themeColorMeta.setAttribute('content', '#000000');
        if (statusBarStyle) {
          statusBarStyle.setAttribute('content', 'black-translucent');
        }
        // Update status bar background color via CSS variable
        document.documentElement.style.setProperty('--status-bar-bg', '#000000');
      } else {
        // When at top - white/light status bar
        themeColorMeta.setAttribute('content', '#ffffff');
        if (statusBarStyle) {
          statusBarStyle.setAttribute('content', 'default');
        }
        // Update status bar background color via CSS variable
        document.documentElement.style.setProperty('--status-bar-bg', '#ffffff');
      }
    };
    
    // Listen for scroll events
    window.addEventListener('scroll', updateThemeColor);
    // Call once on load
    updateThemeColor();
    
    // Also handle when navbar is toggled with scroll
    // Create an observer to watch for navbar class changes
    const observer = new MutationObserver((mutations) => {
      mutations.forEach((mutation) => {
        if (mutation.attributeName === 'class') {
          updateThemeColor();
        }
      });
    });
    
    // Wait for navbar to exist
    const waitForNavbar = setInterval(() => {
      const nav = document.querySelector('nav');
      if (nav) {
        observer.observe(nav, { attributes: true });
        clearInterval(waitForNavbar);
      }
    }, 100);
  </script>
</body>
</html>