---
import '../styles/app.css';

export interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = "SND Studio — A creative studio from Uganda building digital products, brand identities, and physical goods. Think It. Create It.",
  image = "/SND1.png"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />

  <!-- Open Graph -->
  <meta property="og:type"        content="website" />
  <meta property="og:url"         content={canonicalURL} />
  <meta property="og:title"       content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image"       content={new URL(image, Astro.site)} />
  <meta property="og:site_name"   content="SND Studio" />
  <meta property="og:locale"      content="en_UG" />

  <!-- Twitter Card -->
  <meta name="twitter:card"        content="summary_large_image" />
  <meta name="twitter:title"       content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image"       content={new URL(image, Astro.site)} />

  <!-- Status bar: translucent so it blends with the frosted nav (in standalone /
       installed mode the page draws under a transparent status bar) -->
  <meta name="theme-color" content="#ffffff" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

  <!-- Skia is the brand face on macOS; Inter is loaded only as a fallback so
       non-macOS devices (which lack Skia) render Inter instead of Helvetica.
       Loaded async (print→all swap) so it never blocks first paint. -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" media="print" onload="this.media='all'"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" />
  <noscript>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" />
  </noscript>

  <!-- Favicons -->
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
  <link rel="icon" type="image/png" sizes="180x180" href="/SND1.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/SND1.png" />

  <title>{title}</title>

  <!-- Show the intro loader before first paint, but only once per session
       (no flash on navigation). Adding .intro-active locks scroll + reveals #intro. -->
  <script is:inline>
    try {
      if (!sessionStorage.getItem('sndIntroSeen')) {
        document.documentElement.classList.add('intro-active');
      }
    } catch (e) {}
  </script>

  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      margin: 0;
      padding: 0;
      width: 100%;
      overflow-x: hidden;
      overflow-y: auto;
      position: relative;
    }

    html {
      overflow-x: hidden;
      width: 100%;
      position: relative;
    }

    /* ── INTRO LOADER ── */
    /* Lock the page under the loader so the hero can't show through or scroll. */
    html.intro-active, html.intro-active body { overflow: hidden; height: 100%; }
    #intro {
      position: fixed; inset: 0; z-index: 99999;
      display: flex; align-items: center; justify-content: center;
      background: #ffffff;
      transition: opacity 0.45s ease;
      will-change: opacity;
    }
    #intro.is-done { opacity: 0; pointer-events: none; }
    #intro video {
      width: clamp(96px, 22vw, 132px); height: auto;
      display: block;
      /* video has a baked white background; multiply drops it on the white screen */
      mix-blend-mode: multiply;
    }
    /* Hidden until the script confirms it should run (avoids a flash on navigation) */
    html:not(.intro-active) #intro { display: none; }
    @media (prefers-reduced-motion: reduce) {
      #intro video { display: none; }
    }
  </style>
</head>
<body>
  <div id="intro" aria-hidden="true">
    <video src="/snd-logo.mp4" muted playsinline autoplay preload="auto"></video>
  </div>

  <slot />

  <script is:inline>
    (function () {
      const html = document.documentElement;
      const intro = document.getElementById('intro');
      // Not active this load? Make sure it's gone and the page is unlocked.
      if (!intro || !html.classList.contains('intro-active')) {
        html.classList.remove('intro-active');
        intro && intro.remove();
        return;
      }
      const video = intro.querySelector('video');
      const start = Date.now();
      const MIN = 1100;   // keep the loader up at least this long
      const MAX = 3200;   // never hang longer than this
      let done = false;

      function finish() {
        if (done) return;
        done = true;
        const wait = Math.max(0, MIN - (Date.now() - start));
        setTimeout(function () {
          intro.classList.add('is-done');
          try { sessionStorage.setItem('sndIntroSeen', '1'); } catch (e) {}
          // Unlock scroll only after the fade has started so the hero slides in cleanly.
          setTimeout(function () {
            html.classList.remove('intro-active');
            intro.remove();
          }, 500);
        }, wait);
      }

      if (video && video.play) { video.play().catch(function () {}); }
      video && video.addEventListener('ended', finish);
      window.addEventListener('load', finish);
      setTimeout(finish, MAX); // hard fallback
    })();
  </script>
</body>
</html>
