---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const lastUpdated = new Date().toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric',
});
---

<BaseLayout title="Privacy Policy — SND">

<Header />

<main id="main" tabindex="-1">

<!-- ── HERO ── -->
<section class="legal-hero">
  <div class="legal-hero-inner">
    <span class="eyebrow eyebrow--light">Remi · Academic Assistant</span>
    <h1>Privacy Policy</h1>
    <p>We are committed to protecting your academic data and personal information. This policy explains exactly what we collect, how we use it, and the controls you have.</p>
    <div class="legal-meta">
      <div class="legal-meta-item">
        <span class="legal-meta-label">Product</span>
        <span class="legal-meta-value">Remi App</span>
      </div>
      <div class="legal-meta-item">
        <span class="legal-meta-label">Applies to</span>
        <span class="legal-meta-value">Android (Google Play)</span>
      </div>
      <div class="legal-meta-item">
        <span class="legal-meta-label">Last updated</span>
        <span class="legal-meta-value">{lastUpdated}</span>
      </div>
    </div>
  </div>
</section>

<!-- ── CONTENT ── -->
<div class="legal-layout">
  <aside class="legal-toc">
    <p class="toc-title">Contents</p>
    <ul class="toc-list">
      <li><a href="#introduction">Introduction</a></li>
      <li><a href="#information">Information We Collect</a></li>
      <li><a href="#usage">How We Use Your Information</a></li>
      <li><a href="#ai">AI Assistant &amp; Data Access</a></li>
      <li><a href="#storage">Data Storage &amp; Security</a></li>
      <li><a href="#sharing">Data Sharing</a></li>
      <li><a href="#rights">Your Rights</a></li>
      <li><a href="#children">Children's Privacy</a></li>
      <li><a href="#changes">Changes to This Policy</a></li>
      <li><a href="#contact">Contact</a></li>
    </ul>
  </aside>

  <div class="legal-content">
    <div class="legal-updated">Last updated: {lastUpdated}</div>

    <section class="legal-section" id="introduction">
      <span class="legal-section-num">01 — Introduction</span>
      <h2>Introduction</h2>
      <p>Remi is a mobile-based academic assistant designed to help university students manage timetables, GPA calculations, exams, and academic planning with AI support. This Privacy Policy explains how we collect, use, store, and protect your data when you use the Remi application.</p>
      <div class="legal-callout">
        <p>By using Remi, you agree to the collection and use of information in accordance with this policy. We encourage you to read it in full so you understand your rights and how your data is handled.</p>
      </div>
    </section>

    <section class="legal-section" id="information">
      <span class="legal-section-num">02 — Data Collection</span>
      <h2>Information We Collect</h2>
      <p>We collect information you provide during registration and onboarding. This includes:</p>
      <ul class="legal-list">
        <li>Account registration details provided during sign-up</li>
        <li>Academic details such as course structure and programme information</li>
        <li>Timetable entries and class schedules you create within the app</li>
        <li>Exam schedules and deadline dates you input</li>
        <li>GPA records and grade data you enter for calculation</li>
        <li>Basic technical data required for app functionality (e.g. device type, OS version)</li>
      </ul>
      <p>We only collect data that is necessary to deliver Remi's features. We do not collect location data, contacts, or any information unrelated to your academic use of the app.</p>
    </section>

    <section class="legal-section" id="usage">
      <span class="legal-section-num">03 — Data Usage</span>
      <h2>How We Use Your Information</h2>
      <p>Your information is used solely to provide Remi's core features. Specifically, your data enables:</p>
      <ul class="legal-list">
        <li>Timetable management and schedule display</li>
        <li>GPA calculation and academic performance tracking</li>
        <li>Exam planning and deadline reminders</li>
        <li>Personalized AI assistance based on your academic context</li>
        <li>App performance monitoring and bug resolution</li>
      </ul>
      <p>We do not use your data for advertising, profiling, or any purpose outside of providing the Remi service to you.</p>
    </section>

    <section class="legal-section" id="ai">
      <span class="legal-section-num">04 — AI Assistant</span>
      <h2>AI Assistant and Data Access</h2>
      <p>The Remi AI assistant accesses limited academic data strictly to provide personalized responses. This includes your timetable entries, upcoming exams, and GPA history, only to the extent needed to answer your queries meaningfully.</p>
      <div class="legal-callout">
        <p>Chat history within the AI assistant is limited and managed carefully to preserve your privacy. Conversations are not stored indefinitely and are not used to train external AI models.</p>
      </div>
      <p>AI processing may involve transmitting limited data to a third-party AI provider. This is the only instance in which academic data leaves the Remi system, and it is done solely to power the assistant feature.</p>
    </section>

    <section class="legal-section" id="storage">
      <span class="legal-section-num">05 — Storage &amp; Security</span>
      <h2>Data Storage and Security</h2>
      <p>All user data is securely stored using Firebase Firestore, which includes authentication and role-based access controls. We take the following measures to protect your data:</p>
      <ul class="legal-list">
        <li>All data transmission is encrypted using HTTPS</li>
        <li>Access to user data is restricted to authorised users only</li>
        <li>Firebase security rules are applied to prevent unauthorised read or write access</li>
        <li>Authentication is required before any personal data can be accessed or modified</li>
      </ul>
      <p>While we implement industry-standard security practices, no method of transmission or storage is 100% secure. We continually review and improve our security measures.</p>
    </section>

    <section class="legal-section" id="sharing">
      <span class="legal-section-num">06 — Data Sharing</span>
      <h2>Data Sharing</h2>
      <p>Remi does not sell, trade, or rent your personal data to third parties. Your academic information is treated as private and confidential.</p>
      <div class="legal-callout">
        <p>Academic data is not shared externally except where strictly required for essential app functionality, specifically, limited data shared with our AI processing provider to power the assistant feature.</p>
      </div>
      <p>We do not share your data with advertisers, analytics companies, or any third parties for commercial purposes.</p>
    </section>

    <section class="legal-section" id="rights">
      <span class="legal-section-num">07 — Your Rights</span>
      <h2>User Rights</h2>
      <p>You have full control over your data. At any time, you may:</p>
      <ul class="legal-list">
        <li>Access the data stored in your Remi account</li>
        <li>Update or correct any of your academic information within the app</li>
        <li>Request complete deletion of your account and all associated data</li>
      </ul>
      <p>To request deletion of your account and all associated data, please follow the steps described on the page linked below:</p>
      <a href="#" class="deletion-box">
        <span class="deletion-box-text">
          <strong>Account &amp; Data Deletion Instructions</strong>
          <span>Step-by-step guide to deleting your Remi account and data</span>
        </span>
        <span class="deletion-box-arrow" aria-hidden="true">&rarr;</span>
      </a>
    </section>

    <section class="legal-section" id="children">
      <span class="legal-section-num">08 — Children's Privacy</span>
      <h2>Children's Privacy</h2>
      <p>Remi is intended for university students and is not designed for or directed at children under the age of 13. We do not knowingly collect personal data from anyone under 13 years of age.</p>
      <p>If we become aware that a child under 13 has provided personal information, we will take immediate steps to delete that data from our systems.</p>
    </section>

    <section class="legal-section" id="changes">
      <span class="legal-section-num">09 — Policy Updates</span>
      <h2>Changes to This Policy</h2>
      <p>We may update this Privacy Policy from time to time to reflect changes in our practices, technology, or legal requirements. When we make updates, we will:</p>
      <ul class="legal-list">
        <li>Update the "Last updated" date at the top of this page</li>
        <li>Notify users through an in-app notification or message where the change is significant</li>
        <li>Post the revised policy on this page</li>
      </ul>
      <p>We encourage you to review this policy periodically. Continued use of Remi after any changes constitutes your acceptance of the updated policy.</p>
    </section>

    <section class="legal-section" id="contact">
      <span class="legal-section-num">10 — Contact</span>
      <h2>Contact Information</h2>
      <p>If you have any questions, concerns, or requests regarding this Privacy Policy or how your data is handled, please contact us using the support options available within the Remi app.</p>
      <p>You can also reach the SND team, the developers behind Remi, through the contact section on this website.</p>
      <div class="legal-callout">
        <p>We aim to respond to all privacy-related enquiries within 5 business days.</p>
      </div>
    </section>
  </div>
</div>

</main>

<Footer />

</BaseLayout>

<style>
  .deletion-box {
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
    border: 1px solid var(--gray-200); border-radius: var(--r);
    padding: 18px 20px; margin-top: 16px; text-decoration: none;
    transition: border-color 0.18s, background 0.18s;
  }
  .deletion-box:hover { border-color: var(--black); background: var(--gray-50); }
  .deletion-box-text { display: flex; flex-direction: column; gap: 3px; }
  .deletion-box-text strong { font-size: 0.92rem; font-weight: 600; color: var(--black); }
  .deletion-box-text span { font-size: 0.8rem; color: var(--gray-400); }
  .deletion-box-arrow { font-size: 1rem; color: var(--gray-600); transition: transform 0.2s var(--ease); }
  .deletion-box:hover .deletion-box-arrow { transform: translateX(4px); }
</style>

<script>
  const sections = document.querySelectorAll('.legal-section');
  const tocLinks = document.querySelectorAll<HTMLAnchorElement>('.toc-list a');
  const obs = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        const id = entry.target.id;
        tocLinks.forEach((link) =>
          link.classList.toggle('active', link.getAttribute('href') === `#${id}`)
        );
      }
    });
  }, { rootMargin: '-30% 0px -60% 0px' });
  sections.forEach((s) => obs.observe(s));
</script>
