---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import CTA from '../components/CTA.astro';
---

<BaseLayout title="About Us — SND | Think It. Create It.">
  <Navbar />

  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&display=swap');

    * { margin: 0; padding: 0; box-sizing: border-box; }

    :root {
      --snd-dark:   #343940;
      --snd-light:  #CFCFD3;
      --snd-black:  #0d0d0d;
      --snd-white:  #ffffff;
      --remi-blue:  #535FFD;
      --remi-amber: #FDAC1B;
      --font-display: 'Playfair Display', Georgia, serif;
      --font-body: 'Skia', 'Inter', 'Helvetica Neue', system-ui, sans-serif;
    }

    body {
      background: var(--snd-white);
      color: var(--snd-black);
      font-family: var(--font-body);
      line-height: 1.5;
    }

    /* Hero Tagline */
    .hero-tagline {
      text-align: center;
      padding: 8rem 2rem 3rem;
    }

    .hero-tagline h1 {
      font-family: var(--font-display);
      font-size: clamp(3rem, 6vw, 5rem);
      font-weight: 700;
      color: var(--snd-black);
      margin-bottom: 1rem;
      letter-spacing: -0.02em;
    }

    .hero-tagline p {
      color: #5f6c7a;
      font-size: 1.1rem;
      max-width: 600px;
      margin: 0 auto;
    }

    /* Content Sections */
    .about-content {
      max-width: 1200px;
      margin: 0 auto;
      padding: 2rem 4rem 5rem;
    }

    /* Mission & Vision Section */
    .mission-vision {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
      margin-bottom: 5rem;
    }

    .mission-card, .vision-card {
      background: #f9fafb;
      border-radius: 8px;
      padding: 2rem;
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .mission-card:hover, .vision-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 15px 30px -12px rgba(0,0,0,0.1);
    }

    .mission-card .section-label, .vision-card .section-label {
      color: var(--snd-dark);
      font-size: 0.7rem;
      letter-spacing: 0.15em;
      margin-bottom: 1rem;
      font-weight: 600;
      text-transform: uppercase;
      opacity: 0.7;
    }

    .mission-card h2, .vision-card h2 {
      font-family: var(--font-display);
      font-size: clamp(1.5rem, 3vw, 2rem);
      font-weight: 700;
      color: var(--snd-black);
      margin-bottom: 1rem;
    }

    .mission-card p, .vision-card p {
      color: #5f6c7a;
      line-height: 1.7;
      font-size: 0.95rem;
    }

    /* Core Operating Areas with Background Images */
    .operating-areas {
      padding: 120px 6%;
      background: #ffffff;
    }

    .section-label {
      font-size: 12px;
      letter-spacing: 0.2em;
      font-weight: 600;
      color: #7a7a7a;
      margin-bottom: 18px;
    }

    .operating-areas h2 {
      font-size: 40px;
      line-height: 1;
      letter-spacing: -0.05em;
      color: #000;
      margin-bottom: 70px;
      max-width: 900px;
    }

    .areas-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(320px, 1fr));
      gap: 28px;
      width: 100%;
    }

    .area-card {
      position: relative;
      background: #f5f5f5;
      border: 1px solid #e8e8e8;
      border-radius: 8px;
      padding: 48px;
      min-height: 420px;

      display: flex;
      flex-direction: column;
      justify-content: space-between;

      transition: all 0.35s ease;
      overflow: hidden;
    }

    .area-card:hover {
      transform: translateY(-6px);
      background: #000;
      border-color: #000;
    }

    .area-card:hover h3,
    .area-card:hover p,
    .area-card:hover .card-number {
      color: #fff;
    }

    .area-card:hover .area-tag {
      background: rgba(255,255,255,0.1);
      color: #fff;
      border-color: rgba(255,255,255,0.15);
    }

    .card-number {
      font-size: 0.95rem;
      font-weight: 600;
      color: #8d8d8d;
      margin-bottom: 70px;
      transition: 0.35s ease;
    }

    .card-content h3 {
      font-size: 2.1rem;
      letter-spacing: -0.04em;
      margin-bottom: 22px;
      color: #000;
      transition: 0.35s ease;
    }

    .card-content p {
      font-size: 1rem;
      line-height: 1.9;
      color: #5f5f5f;
      margin-bottom: 36px;
      transition: 0.35s ease;
    }

    .area-tag {
      display: inline-flex;
      align-items: center;
      width: fit-content;

      padding: 12px 18px;
      border-radius: 999px;

      background: #fff;
      border: 1px solid #e2e2e2;

      font-size: 0.85rem;
      font-weight: 500;
      color: #444;

      transition: 0.35s ease;
    }

    @media (max-width: 1100px) {
      .areas-grid {
        grid-template-columns: 1fr;
      }

      .area-card {
        min-height: auto;
      }

      .operating-areas {
        padding: 90px 6%;
      }
    }

    /* Stats Grid */
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
      margin: 4rem 0;
      padding: 2rem 0;
      border-top: 1px solid var(--snd-light);
      border-bottom: 1px solid var(--snd-light);
    }

    .stat-item {
      text-align: center;
    }

    .stat-number {
      font-family: var(--font-display);
      font-size: 2.5rem;
      font-weight: 700;
      color: var(--snd-dark);
      margin-bottom: 0.5rem;
    }

    .stat-label {
      font-size: 0.85rem;
      color: #8a9bb0;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    /* Two Column Layout */
    .two-column {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
      margin: 4rem 0;
      align-items: center;
    }

    .column-content h3 {
      font-family: var(--font-display);
      font-size: 1.8rem;
      font-weight: 700;
      color: var(--snd-black);
      margin-bottom: 1rem;
    }

    .column-content p {
      color: #5f6c7a;
      line-height: 1.8;
      margin-bottom: 1rem;
    }

    .column-image {
      border-radius: 8px;
      overflow: hidden;
      background: var(--snd-light);
    }

    .column-image img {
      width: 100%;
      height: auto;
      display: block;
      transition: transform 0.4s ease;
    }

    .column-image:hover img {
      transform: scale(1.02);
    }

    /* Responsive */
    @media (max-width: 900px) {
      .hero-tagline { padding: 6rem 1.5rem 2rem; }
      .about-content { padding: 2rem 1.5rem 4rem; }
      .mission-vision { grid-template-columns: 1fr; gap: 1.5rem; }
      .areas-grid { grid-template-columns: 1fr; gap: 1.5rem; }
      .stats-grid { grid-template-columns: repeat(2, 1fr); gap: 1.5rem; }
      .two-column { grid-template-columns: 1fr; gap: 2rem; }
    }
  </style>

  <!-- Hero Tagline - Think It. Create It. -->
  <div class="hero-tagline">
    <h1>Think It.<br/>Create It.</h1>
    <p>We turn ideas into reality through thoughtful design, innovative development, and genuine collaboration.</p>
  </div>

  <!-- Main Content -->
  <div class="about-content">
    
    <!-- Mission & Vision Section -->
    <div class="mission-vision">
      <div class="vision-card">
        <div class="section-label">OUR VISION</div>
        <h2>To become a leading African brand</h2>
        <p>Building intelligent, creative, and culturally relevant solutions through the integrated disciplines of technology, art, and design. The goal is to demonstrate that world-class digital products and design systems can originate from Uganda and serve both local and global audiences.</p>
      </div>
      <div class="mission-card">
        <div class="section-label">OUR MISSION</div>
        <h2>Simplify complex problems</h2>
        <p>Through thoughtful, well-crafted systems that combine functional design, artificial intelligence, and genuine human understanding. Every product — whether a mobile application, a brand identity, or a physical notebook — must serve a clear purpose and provide a seamless user experience.</p>
      </div>
    </div>

        <!-- Stats Grid -->
    <div class="stats-grid">
      <div class="stat-item">
        <div class="stat-number">10+</div>
        <div class="stat-label">Projects Completed</div>
      </div>
      <div class="stat-item">
        <div class="stat-number">15+</div>
        <div class="stat-label">Happy Clients</div>
      </div>
      <div class="stat-item">
        <div class="stat-number">3+</div>
        <div class="stat-label">Years of Experience</div>
      </div>
    </div>

    <!-- Core Operating Areas -->
    <div class="operating-areas">
      <div class="section-label">CORE OPERATING AREAS</div>
      <h2>Three Interconnected Domains</h2>

      <div class="areas-grid">

        <div class="area-card">
          <div class="card-number">01</div>

          <div class="card-content">
            <h3>Technology</h3>

            <p>
              Building applications, tools, and platforms designed to solve
              real-world organizational and productivity problems. From concept
              to launch, SND develops scalable digital systems with long-term
              usability in mind.
            </p>

            <span class="area-tag">
              Digital Products · REMI · Software Tools
            </span>
          </div>
        </div>

        <div class="area-card">
          <div class="card-number">02</div>

          <div class="card-content">
            <h3>Art & Design</h3>

            <p>
              Creating visual identity systems, interfaces, motion graphics,
              and brand experiences that combine clarity with aesthetics.
              Every design decision is made to strengthen usability,
              communication, and perception.
            </p>

            <span class="area-tag">
              Branding · UI/UX · Motion Graphics
            </span>
          </div>
        </div>

        <div class="area-card">
          <div class="card-number">03</div>

          <div class="card-content">
            <h3>Fashion & Physical Goods</h3>

            <p>
              Expanding the SND ecosystem through thoughtfully designed
              merchandise and physical products that increase visibility,
              strengthen identity, and create additional revenue channels.
            </p>

            <span class="area-tag">
              Notebooks · Apparel · Merchandise
            </span>
          </div>
        </div>

      </div>
    </div>



