---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const lastUpdated = new Date().toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric',
});
---

<BaseLayout title="Terms & Conditions — SND">

<Header />

<main id="main" tabindex="-1">

<!-- ── HERO ── -->
<section class="legal-hero">
  <div class="legal-hero-inner">
    <span class="eyebrow eyebrow--light">Remi · Academic Assistant</span>
    <h1>Terms &amp; Conditions</h1>
    <p>Please read these terms carefully before using the Remi application. By using our service, you agree to be bound by these terms.</p>
    <div class="legal-meta">
      <div class="legal-meta-item">
        <span class="legal-meta-label">Product</span>
        <span class="legal-meta-value">Remi App</span>
      </div>
      <div class="legal-meta-item">
        <span class="legal-meta-label">Applies to</span>
        <span class="legal-meta-value">Android (Google Play)</span>
      </div>
      <div class="legal-meta-item">
        <span class="legal-meta-label">Last updated</span>
        <span class="legal-meta-value">{lastUpdated}</span>
      </div>
    </div>
  </div>
</section>

<!-- ── CONTENT ── -->
<div class="legal-layout">
  <aside class="legal-toc">
    <p class="toc-title">Contents</p>
    <ul class="toc-list">
      <li><a href="#introduction">Introduction</a></li>
      <li><a href="#use-of-app">Use of the App</a></li>
      <li><a href="#user-accounts">User Accounts</a></li>
      <li><a href="#data-accuracy">Academic Data Accuracy</a></li>
      <li><a href="#ai-disclaimer">AI Assistance Disclaimer</a></li>
      <li><a href="#intellectual-property">Intellectual Property</a></li>
      <li><a href="#limitation-liability">Limitation of Liability</a></li>
      <li><a href="#termination">Termination</a></li>
      <li><a href="#changes">Changes to Terms</a></li>
      <li><a href="#governing-law">Governing Law</a></li>
      <li><a href="#contact">Contact</a></li>
    </ul>
  </aside>

  <div class="legal-content">
    <div class="legal-updated">Last updated: {lastUpdated}</div>

    <section class="legal-section" id="introduction">
      <span class="legal-section-num">01 — Introduction</span>
      <h2>Introduction</h2>
      <p>These Terms and Conditions govern your use of the Remi mobile application. By using the app, you agree to these terms. If you do not agree with any part of these terms, please do not use the application.</p>
      <div class="legal-callout">
        <p>Remi is an academic assistance tool designed to help university students manage their studies. These terms form a legally binding agreement between you and the developer of Remi.</p>
      </div>
    </section>

    <section class="legal-section" id="use-of-app">
      <span class="legal-section-num">02 — Use of the App</span>
      <h2>Use of the App</h2>
      <p>Remi is provided as an academic assistance tool. You agree to use the app only for lawful and educational purposes. You may not:</p>
      <ul class="legal-list">
        <li>Use the app for any illegal activities</li>
        <li>Attempt to reverse engineer or extract the source code</li>
        <li>Interfere with or disrupt the app's functionality</li>
        <li>Use the app to harass, abuse, or harm others</li>
      </ul>
    </section>

    <section class="legal-section" id="user-accounts">
      <span class="legal-section-num">03 — User Accounts</span>
      <h2>User Accounts</h2>
      <p>You are responsible for maintaining the confidentiality of your login credentials and for all activities conducted through your account. You agree to:</p>
      <ul class="legal-list">
        <li>Provide accurate and complete information during registration</li>
        <li>Notify us immediately of any unauthorized use of your account</li>
        <li>Accept responsibility for all activities that occur under your account</li>
      </ul>
      <p>We reserve the right to suspend or terminate accounts that violate these terms or pose a security risk.</p>
    </section>

    <section class="legal-section" id="data-accuracy">
      <span class="legal-section-num">04 — Academic Data Accuracy</span>
      <h2>Academic Data Accuracy</h2>
      <p>While Remi provides automated GPA calculations, timetable management, and scheduling tools, the app does not guarantee academic outcomes. Important notes:</p>
      <ul class="legal-list">
        <li>Users are responsible for verifying official academic records with their institution</li>
        <li>GPA calculations are estimates based on user-provided data</li>
        <li>We are not responsible for any discrepancies between app data and official records</li>
        <li>The app should not be used as the sole source for academic decision-making</li>
      </ul>
      <div class="legal-callout">
        <p>Always verify critical academic information with your university's official systems. Remi is a supplementary tool, not an official academic record keeper.</p>
      </div>
    </section>

    <section class="legal-section" id="ai-disclaimer">
      <span class="legal-section-num">05 — AI Assistance Disclaimer</span>
      <h2>AI Assistance Disclaimer</h2>
      <p>The AI assistant in Remi provides guidance based on user-provided academic data. Please understand that:</p>
      <ul class="legal-list">
        <li>AI responses are informational and generated automatically</li>
        <li>Responses should not replace official academic advice from your institution</li>
        <li>We do not guarantee the accuracy, completeness, or usefulness of AI-generated content</li>
        <li>You assume full responsibility for any actions taken based on AI suggestions</li>
      </ul>
    </section>

    <section class="legal-section" id="intellectual-property">
      <span class="legal-section-num">06 — Intellectual Property</span>
      <h2>Intellectual Property</h2>
      <p>All content, features, and functionality of the Remi app, including but not limited to code, design, text, graphics, logos, and user interface, are the exclusive property of the developer and are protected by copyright and other intellectual property laws.</p>
      <p>You may not copy, modify, distribute, sell, or lease any part of the app without explicit written permission.</p>
    </section>

    <section class="legal-section" id="limitation-liability">
      <span class="legal-section-num">07 — Limitation of Liability</span>
      <h2>Limitation of Liability</h2>
      <p>Remi is provided on an "as is" and "as available" basis. To the fullest extent permitted by law:</p>
      <ul class="legal-list">
        <li>We are not liable for any academic decisions made using the app</li>
        <li>We are not responsible for data loss or corruption</li>
        <li>We are not liable for any indirect, incidental, or consequential damages</li>
        <li>We do not warrant that the app will be uninterrupted or error-free</li>
      </ul>
      <div class="legal-callout">
        <p>Your use of the app is at your sole risk. In no event shall the developer be liable for any damages arising from your use or inability to use the app.</p>
      </div>
    </section>

    <section class="legal-section" id="termination">
      <span class="legal-section-num">08 — Termination</span>
      <h2>Termination</h2>
      <p>We reserve the right to suspend or terminate accounts that misuse the app or violate these terms. Grounds for termination include:</p>
      <ul class="legal-list">
        <li>Violation of these Terms and Conditions</li>
        <li>Abuse of the app's features or services</li>
        <li>Engaging in fraudulent or illegal activities</li>
        <li>Any behavior that harms other users or the app's functionality</li>
      </ul>
      <p>You may also delete your account and stop using the app at any time. Upon termination, your data will be handled in accordance with our Privacy Policy.</p>
    </section>

    <section class="legal-section" id="changes">
      <span class="legal-section-num">09 — Changes to Terms</span>
      <h2>Changes to Terms</h2>
      <p>We may update these Terms and Conditions periodically to reflect changes in our practices, legal requirements, or app features. When we make changes:</p>
      <ul class="legal-list">
        <li>We will update the "Last updated" date at the top of this page</li>
        <li>We will notify users through the app of significant changes</li>
        <li>Continued use of the app after changes indicates acceptance of the updated terms</li>
      </ul>
    </section>

    <section class="legal-section" id="governing-law">
      <span class="legal-section-num">10 — Governing Law</span>
      <h2>Governing Law</h2>
      <p>These Terms and Conditions are governed by and construed in accordance with the laws applicable in Uganda. Any disputes arising from these terms or your use of the app shall be subject to the exclusive jurisdiction of the courts of Uganda.</p>
    </section>

    <section class="legal-section" id="contact">
      <span class="legal-section-num">11 — Contact</span>
      <h2>Contact Information</h2>
      <p>For questions regarding these Terms and Conditions, please contact us through the support options available within the Remi app.</p>
      <p>You can also reach the SND team, the developers behind Remi, through the contact section on this website.</p>
    </section>
  </div>
</div>

</main>

<Footer />

</BaseLayout>

<script>
  const sections = document.querySelectorAll('.legal-section');
  const tocLinks = document.querySelectorAll<HTMLAnchorElement>('.toc-list a');
  const obs = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        const id = entry.target.id;
        tocLinks.forEach((link) =>
          link.classList.toggle('active', link.getAttribute('href') === `#${id}`)
        );
      }
    });
  }, { rootMargin: '-30% 0px -60% 0px' });
  sections.forEach((s) => obs.observe(s));
</script>
