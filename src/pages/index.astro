---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="SND: Think It. Create It.">

<Header homepage={true} />

<!-- Panel backdrop + panel -->
<div class="panel-backdrop" id="panelBackdrop"></div>
<aside class="panel" id="panel" role="dialog" aria-modal="true" aria-label="Section details">
  <button class="panel-close" id="panelClose" aria-label="Close panel">&#x2715;</button>
  <div class="panel-inner" id="panelInner"></div>
  <div class="panel-handle" id="panelHandle" role="button" tabindex="0" aria-label="Drag up to close"><span></span></div>
</aside>

<main id="main" tabindex="-1">

<!-- ── HERO ── -->
<section class="hero" id="home">
  <div class="hero-bg"></div>
  <div class="container hero-inner">
    <div class="hero-content reveal">
      <span class="eyebrow">A creative studio</span>
      <h1 class="hero-title">Think It.<br />Create It.</h1>
      <p class="hero-subtitle">
        The power of our creative minds is perhaps the greatest
        gift each of us possess
      </p>
      <div class="hero-cta">
        <a href="#studio"  class="btn btn--dark">About SND <span class="arrow">&#8594;</span></a>
        <a href="#contact" class="btn btn--ghost-dark">Join the community</a>
      </div>
    </div>
    <div class="hero-visual reveal">
      <div class="hero-img-wrap">
        <img src="/hero-image.webp" alt="SND creative work" fetchpriority="high" decoding="async" />
      </div>
    </div>
  </div>
  <div class="scroll-cue">
    <span class="scroll-line"></span>
  </div>
</section>

<!-- ── FEATURE STRIP ── -->
<section class="feature-strip">
  <div class="container feature-strip-inner">
    <div class="feature-strip-item">
      <div class="fs-flip">
        <div class="fs-face fs-front"><img src="/icons/design.svg" class="fs-icon" alt="" /></div>
        <div class="fs-face fs-back">
          <span class="fs-label">Design</span>
          <span class="fs-value">Human-first</span>
        </div>
      </div>
    </div>
    <div class="feature-strip-item">
      <div class="fs-flip">
        <div class="fs-face fs-front"><img src="/icons/location.svg" class="fs-icon" alt="" /></div>
        <div class="fs-face fs-back">
          <span class="fs-label">Built in</span>
          <span class="fs-value">Uganda</span>
        </div>
      </div>
    </div>
    <div class="feature-strip-item">
      <div class="fs-flip">
        <div class="fs-face fs-front"><img src="/icons/flow-chart.svg" class="fs-icon" alt="" /></div>
        <div class="fs-face fs-back">
          <span class="fs-label">Disciplines</span>
          <span class="fs-value">Tech &middot; Art &middot; Goods</span>
        </div>
      </div>
    </div>
    <div class="feature-strip-item">
      <div class="fs-flip">
        <div class="fs-face fs-front"><img src="/icons/clock.svg" class="fs-icon" alt="" /></div>
        <div class="fs-face fs-back">
          <span class="fs-label">Since</span>
          <span class="fs-value">2025</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ── WORK / CARDS ── -->
<section class="work" id="work">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">The Craft</span>
      <h2 class="section-title">Explore the studio.</h2>
    </div>
    <div class="work-grid">
      <article class="work-card reveal" data-panel="design">
        <div class="work-card-img">
          <img src="/design.webp" alt="Design" loading="lazy" decoding="async" />
          <span class="work-card-num">01</span>
        </div>
        <div class="work-card-body">
          <h3>Design</h3>
          <p>Solving problems and creating functional, purposeful experiences.</p>
          <span class="work-card-cta">Explore <span class="arrow">&#8594;</span></span>
        </div>
      </article>
      <article class="work-card reveal" data-panel="art">
        <div class="work-card-img">
          <img src="/art.jpg" alt="Art" loading="lazy" decoding="async" />
          <span class="work-card-num">02</span>
        </div>
        <div class="work-card-body">
          <h3>Art</h3>
          <p>Expression, imagination, and creativity made visible.</p>
          <span class="work-card-cta">Explore <span class="arrow">&#8594;</span></span>
        </div>
      </article>
      <article class="work-card reveal" data-panel="fashion">
        <div class="work-card-img">
          <img src="/fashion.webp" alt="Fashion" loading="lazy" decoding="async" />
          <span class="work-card-num">03</span>
        </div>
        <div class="work-card-body">
          <h3>Fashion</h3>
          <p>Personal identity and aesthetics expressed through style.</p>
          <span class="work-card-cta">Explore <span class="arrow">&#8594;</span></span>
        </div>
      </article>
      <article class="work-card reveal" data-panel="development">
        <div class="work-card-img">
          <img src="/development2.png" alt="Development" loading="lazy" decoding="async" />
          <span class="work-card-num">04</span>
        </div>
        <div class="work-card-body">
          <h3>Development</h3>
          <p>Building systems, tools, and technology.</p>
          <span class="work-card-cta">Explore <span class="arrow">&#8594;</span></span>
        </div>
      </article>
    </div>
  </div>
</section>

<!-- ── STUDIO ── -->
<section class="studio" id="studio">
  <div class="container studio-inner">
    <div class="studio-copy reveal">
      <span class="eyebrow eyebrow--light">Philosophy</span>
      <h2 class="section-title section-title--light">The Muse.</h2>
      <p class="studio-lead">
        SND is driven by a deep passion for four interconnected disciplines: Design,
        Art, Fashion, and Development.
      </p>
      <p class="studio-lead">
        These disciplines are not isolated fields, they constantly influence and strengthen
        one another. Development relies on thoughtful design, design and fashion draw from
        art, and together they form a creative ecosystem that shapes how we live, work,
        and interact.
      </p>
      <p class="studio-lead">
        This understanding is the foundation of SND, fueling innovation and guiding the
        creation of meaningful, impactful work.
      </p>
      <div class="studio-mv">
        <div class="mv-card">
          <span class="mv-label">The Vision</span>
          <h4>To become a leading African brand</h4>
          <p>Demonstrating that world-class products can originate from Uganda and serve both local and global audiences.</p>
        </div>
        <div class="mv-card">
          <span class="mv-label">The Mission</span>
          <h4>Simplify complex problems</h4>
          <p>Through thoughtful, well-crafted systems that combine functional design, artificial intelligence, and genuine human understanding.</p>
        </div>
      </div>
    </div>
    <div class="studio-visual reveal">
      <div class="studio-img-main">
        <img src="/muse.webp" alt="The Muse" loading="lazy" decoding="async" />
      </div>
      <div class="studio-stats">
        <div class="stat">
          <span class="stat-n" data-target="10">0</span><span class="stat-plus">+</span>
          <span class="stat-l">Projects</span>
        </div>
        <div class="stat">
          <span class="stat-n" data-target="5">0</span><span class="stat-plus">+</span>
          <span class="stat-l">Partnerships</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ── INSIDE STORIES STRIP ── -->
<a class="stories-strip" id="stories" href="/inside-stories">
  <div class="container stories-inner">
    <div class="stories-text">
      <span class="eyebrow eyebrow--light">From the studio</span>
      <h2 class="stories-title">Inside Stories</h2>
      <p class="stories-sub">Behind the work, the craft, ideas, and culture.</p>
    </div>
    <span class="stories-arrow" aria-hidden="true">&#8594;</span>
  </div>
</a>

<!-- ── HIGHLIGHT / NOTEBOOK ── -->
<section class="highlight">
  <div class="container">
    <span class="eyebrow highlight-eyebrow reveal">Today's highlight &middot; Physical Goods</span>
    <div class="highlight-inner">
      <div class="highlight-img reveal">
        <img src="/notebook.jpeg" alt="Lineless Pocket Notebook" loading="lazy" decoding="async" />
      </div>
      <div class="highlight-copy reveal">
        <h2 class="section-title">Lineless Pocket Notebook.</h2>
        <p class="highlight-desc">
          No rules, just space. A clean, minimal notebook designed for creative minds.
          Sketch, write, and think freely without constraints.
        </p>
        <a href="/products" class="btn btn--dark">Shop now <span class="arrow">&#8594;</span></a>
      </div>
    </div>
  </div>
</section>

<!-- ── CTA ── -->
<section class="cta" id="contact">
  <!-- Floating studio snapshots — drift gently behind the call to action -->
  <div class="cta-float" aria-hidden="true">
    <img src="/hero-image.webp" class="cf cf-1" alt="" loading="lazy" decoding="async" />
    <img src="/art.jpg"         class="cf cf-2" alt="" loading="lazy" decoding="async" />
    <img src="/fashion.webp"    class="cf cf-3" alt="" loading="lazy" decoding="async" />
    <img src="/physical.jpg"    class="cf cf-4" alt="" loading="lazy" decoding="async" />
    <img src="/muse.webp"       class="cf cf-5" alt="" loading="lazy" decoding="async" />
    <img src="/design.webp"     class="cf cf-6" alt="" loading="lazy" decoding="async" />
  </div>
  <div class="container cta-inner reveal">
    <span class="eyebrow eyebrow--light">Community</span>
    <h2 class="cta-title">Join the<br />Community.</h2>
    <div class="cta-actions">
      <a href="https://www.instagram.com/snd.studiio/" target="_blank" rel="noopener" class="btn btn--light">Follow on Instagram <span class="arrow">&#8594;</span></a>
      <a href="mailto:sndstudio.ug@gmail.com" class="btn btn--ghost-light">sndstudio.ug@gmail.com</a>
    </div>
    <div class="cta-socials">
      <a href="https://www.instagram.com/snd.studiio/" aria-label="Instagram" target="_blank" rel="noopener"><img src="/instagram.svg" alt="Instagram" /></a>
      <a href="https://tiktok.com/@sndstudio.ug"   aria-label="TikTok"    target="_blank" rel="noopener"><img src="/tiktok.svg"    alt="TikTok" /></a>
      <a href="https://www.threads.com/@snd.studiio"   aria-label="Threads"   target="_blank" rel="noopener"><img src="/threads.svg"   alt="Threads" /></a>
      <a href="https://pinterest.com/sndstudio_ug"  aria-label="Pinterest" target="_blank" rel="noopener"><img src="/pinterest.svg" alt="Pinterest" /></a>
    </div>
  </div>
</section>

</main>

<!-- ── FOOTER ── -->
<Footer />

<style>

  /* Shared tokens, reset, header, buttons, labels & reveal now live in
     src/styles/app.css. This block holds only homepage-specific styles. */

  .section-head { text-align: center; max-width: 560px; margin: 0 auto 56px; }
  .section-title {
    font-size: clamp(2rem, 4.5vw, 3.2rem);
    font-weight: 500; line-height: 1.02; letter-spacing: -0.035em;
  }
  .section-title--light { color: var(--white); }
  .section-desc { color: var(--gray-600); margin-top: 14px; font-size: 0.96rem; }

  /* ── HERO ── */
  .hero {
    padding: calc(var(--header-h) + 80px) 0 80px;
    position: relative; overflow: hidden;
  }
  .hero-bg {
    position: absolute; inset: 0; z-index: 0;
    background-image: radial-gradient(circle, rgba(0,0,0,0.5) 0.9px, transparent 0.9px);
    background-size: 8rem 8rem; background-position: 0 var(--dotY, 0px);
    mask-image: radial-gradient(ellipse 100% 80% at 50% 0%, #000 30%, transparent 85%);
    -webkit-mask-image: radial-gradient(ellipse 100% 80% at 50% 0%, #000 30%, transparent 85%);
  }
  .hero-inner {
    position: relative; z-index: 1;
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 64px; align-items: center;
  }
  .hero-content { max-width: 560px; }
  .hero-title {
    font-size: clamp(3rem, 6.5vw, 5.4rem);
    font-weight: 500; line-height: 0.94;
    letter-spacing: -0.045em; margin-bottom: 24px;
  }
  .hero-subtitle {
    font-size: 0.98rem; color: var(--gray-600);
    line-height: 1.72; margin-bottom: 32px; max-width: 420px;
  }
  .hero-cta { display: flex; gap: 10px; flex-wrap: wrap; }
  .hero-visual { position: relative; }
  .hero-img-wrap {
    border-radius: var(--r); overflow: hidden;
    aspect-ratio: 4/5; border: 1px solid var(--gray-200);
    transition: box-shadow 0.4s var(--ease);
  }
  .hero-img-wrap img {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform 0.6s var(--ease);
  }
  .hero-img-wrap:hover { box-shadow: var(--shadow-md); }
  .hero-img-wrap:hover img { transform: scale(1.03); }
  .scroll-cue {
    position: absolute; bottom: 28px; left: 32px;
    display: flex; align-items: center; gap: 12px;
    font-size: 0.6rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--gray-400);
  }
  .scroll-line { width: 40px; height: 1px; background: var(--gray-400); }

  /* ── FEATURE STRIP ── */
  .feature-strip { background: var(--black); color: var(--white); position: relative; overflow: hidden; }
  .feature-strip::before {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background-image: radial-gradient(circle, rgba(255,255,255,0.5) 0.9px, transparent 0.9px);
    background-size: 8rem 8rem; background-position: 0 var(--dotY, 0px); opacity: 0.32;
  }
  .feature-strip-inner {
    position: relative; z-index: 1;
    display: grid; grid-template-columns: repeat(4, 1fr);
  }
  .feature-strip-item {
    padding: 26px 32px;
    border-right: 1px solid rgba(255,255,255,0.07);
    perspective: 800px;
  }
  .feature-strip-item:last-child { border-right: none; }

  /* Flip tile: icon (front) rolls over to reveal label + value (back) */
  .fs-flip {
    position: relative; min-height: 48px;
    transform-style: preserve-3d;
    transform: rotateX(0deg);
    transition: transform 0.85s cubic-bezier(0.62, 0.04, 0.3, 1);
  }
  .fs-flip.is-flipped { transform: rotateX(180deg); }
  .fs-face {
    position: absolute; inset: 0;
    display: flex; flex-direction: column; justify-content: center; align-items: center;
    gap: 4px; text-align: center;
    backface-visibility: hidden; -webkit-backface-visibility: hidden;
  }
  .fs-back { transform: rotateX(180deg); }
  .fs-icon {
    width: 30px; height: 30px; object-fit: contain;
    filter: brightness(0) invert(1); opacity: 0.92;
  }
  .fs-label {
    font-size: 0.58rem; font-weight: 700;
    letter-spacing: 0.2em; text-transform: uppercase; color: rgba(255,255,255,0.38);
  }
  .fs-value { font-size: 0.9rem; font-weight: 500; }

  /* ── WORK CARDS ── */
  .work { padding: 100px 0; }
  .work-grid {
    display: grid; grid-template-columns: repeat(4, 1fr);
    gap: 1px; background: var(--gray-200); border: 1px solid var(--gray-200);
  }
  .work-card {
    background: var(--white); cursor: pointer; position: relative;
    transition: background 0.18s, box-shadow 0.25s var(--ease), z-index 0s;
    display: flex; flex-direction: column;
  }
  .work-card:hover { background: var(--white); z-index: 2; box-shadow: var(--shadow-md); }
  .work-card-img { position: relative; aspect-ratio: 1; overflow: hidden; }
  .work-card-img img {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform 0.5s var(--ease);
  }
  .work-card:hover .work-card-img img { transform: scale(1.05); }
  .work-card-num {
    position: absolute; top: 12px; left: 12px;
    font-size: 0.58rem; font-weight: 700; letter-spacing: 0.14em;
    color: var(--gray-600); background: rgba(255,255,255,0.92);
    padding: 3px 8px;
  }
  .work-card-body {
    padding: 20px 22px 24px;
    border-top: 1px solid var(--gray-200); flex: 1;
  }
  .work-card-body h3 { font-size: 0.98rem; font-weight: 500; letter-spacing: -0.01em; margin-bottom: 6px; }
  .work-card-body p  { font-size: 0.8rem; color: var(--gray-600); margin-bottom: 14px; line-height: 1.55; }
  .work-card-cta {
    font-size: 0.72rem; font-weight: 700; letter-spacing: 0.04em;
    display: inline-flex; align-items: center; gap: 6px;
  }
  .work-card:hover .work-card-cta .arrow { transform: translateX(4px); }

  /* ── STUDIO ── */
  .studio { background: var(--black); color: var(--white); padding: 100px 0; position: relative; overflow: hidden; }
  .studio::before {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background-image: radial-gradient(circle, rgba(255,255,255,0.5) 0.9px, transparent 0.9px);
    background-size: 8rem 8rem; background-position: 0 var(--dotY, 0px); opacity: 0.32;
  }
  .studio-inner { position: relative; z-index: 1; display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 70px; align-items: center; }
  /* Breathing room between "The Muse." and the lead copy */
  .studio-copy .section-title { margin-bottom: 30px; }
  .studio-lead { color: rgba(255,255,255,0.62); font-size: 1rem; line-height: 1.75; margin-bottom: 36px; max-width: 480px; }
  .studio-mv { display: flex; flex-direction: column; gap: 1px; }
  .mv-card {
    border: 1px solid rgba(255,255,255,0.08); padding: 22px 24px;
    transition: background 0.18s;
  }
  .mv-card + .mv-card { margin-top: 1px; }
  .mv-card:hover { background: rgba(255,255,255,0.04); }
  .mv-label {
    font-size: 0.58rem; font-weight: 700; letter-spacing: 0.2em;
    text-transform: uppercase; color: rgba(255,255,255,0.35);
  }
  .mv-card h4 { font-size: 1rem; font-weight: 500; letter-spacing: -0.01em; margin: 8px 0 8px; }
  .mv-card p  { font-size: 0.84rem; color: rgba(255,255,255,0.58); line-height: 1.65; }
  .studio-visual { position: relative; }
  .studio-img-main { overflow: hidden; aspect-ratio: 4/5; border-radius: var(--r); }
  .studio-img-main img { width: 100%; height: 100%; object-fit: cover; }
  .studio-stats {
    display: flex; gap: 0; margin-top: 1px;
    border: 1px solid rgba(255,255,255,0.08);
  }
  .stat {
    display: flex; flex-direction: column; flex: 1; padding: 20px;
    border-right: 1px solid rgba(255,255,255,0.08);
  }
  .stat:last-child { border-right: none; }
  .stat-n    { font-size: 2.2rem; font-weight: 500; line-height: 1; letter-spacing: -0.04em; display: inline; }
  .stat-plus { font-size: 1.4rem; font-weight: 500; }
  .stat-l    { font-size: 0.6rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(255,255,255,0.38); margin-top: 6px; }

  /* ── HIGHLIGHT ── */
  .highlight { padding: 100px 0; }
  .highlight-eyebrow { display: block; margin-bottom: 32px; }
  .highlight-inner { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: center; }
  .highlight-img {
    overflow: hidden; aspect-ratio: 4/5;
    max-width: 340px; width: 100%; justify-self: center;
    border-radius: var(--r); border: 1px solid var(--gray-200);
    transition: box-shadow 0.4s var(--ease);
  }
  .highlight-img img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s var(--ease); }
  .highlight-img:hover { box-shadow: var(--shadow-md); }
  .highlight-img:hover img { transform: scale(1.03); }
  .highlight-copy { max-width: 480px; }
  .highlight-desc { color: var(--gray-600); font-size: 1rem; line-height: 1.72; margin: 18px 0 28px; }

  /* ── INSIDE STORIES STRIP ── */
  .stories-strip {
    display: block; position: relative; overflow: hidden;
    background: var(--gray-900); color: var(--white);
    transition: background 0.25s var(--ease);
  }
  .stories-strip::before {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background-image: radial-gradient(circle, rgba(255,255,255,0.5) 0.9px, transparent 0.9px);
    background-size: 8rem 8rem; background-position: 0 var(--dotY, 0px); opacity: 0.32;
  }
  .stories-strip:hover { background: var(--black); }
  .stories-inner {
    position: relative; z-index: 1;
    display: flex; align-items: center; justify-content: space-between; gap: 32px;
    padding: 72px 32px;
  }
  .stories-title {
    font-size: clamp(2.4rem, 6vw, 4.4rem); font-weight: 500;
    line-height: 0.96; letter-spacing: -0.045em; margin: 4px 0 12px;
  }
  .stories-sub { color: rgba(255,255,255,0.55); font-size: 0.96rem; max-width: 420px; }
  .stories-arrow {
    font-size: clamp(2rem, 5vw, 3.4rem); line-height: 1; flex-shrink: 0;
    transition: transform 0.3s var(--ease-out);
  }
  .stories-strip:hover .stories-arrow { transform: translateX(12px); }

  /* ── CTA ── */
  .cta { background: var(--black); color: var(--white); padding: 120px 0; text-align: center; position: relative; overflow: hidden; }
  .cta::before {
    content: ''; position: absolute; inset: 0;
    background-image: radial-gradient(circle, rgba(255,255,255,0.5) 0.9px, transparent 0.9px);
    background-size: 8rem 8rem; background-position: 0 var(--dotY, 0px); opacity: 0.32;
  }
  .cta-inner { position: relative; z-index: 1; max-width: 600px; margin: 0 auto; }

  /* Floating snapshots — upright tiles on a symmetric grid at the section's
     edges (Nothing-style alignment), drifting gently behind the content */
  .cta-float { position: absolute; inset: 0; pointer-events: none; z-index: 0; }
  .cf {
    position: absolute; object-fit: cover;
    border: 1px solid rgba(255,255,255,0.16); border-radius: var(--r);
    opacity: 0.85;
    animation: cfDrift var(--dur, 8s) ease-in-out var(--delay, 0s) infinite alternate;
    will-change: transform;
  }
  @keyframes cfDrift {
    from { transform: translateY(-6px); }
    to   { transform: translateY(8px); }
  }
  /* Matched pairs, mirrored positions: corners 4/5 portraits, mid-edges squares */
  .cf-1 { width: 112px; aspect-ratio: 4/5; top: 12%;    left: 7%;   --dur: 7.5s; }
  .cf-2 { width: 112px; aspect-ratio: 4/5; top: 12%;    right: 7%;  --dur: 8.5s; --delay: 0.7s; }
  .cf-3 { width: 112px; aspect-ratio: 4/5; bottom: 12%; left: 7%;   --dur: 9s;   --delay: 0.4s; }
  .cf-4 { width: 112px; aspect-ratio: 4/5; bottom: 12%; right: 7%;  --dur: 7s;   --delay: 1.1s; }
  .cf-5 { width: 80px;  aspect-ratio: 1;   top: 50%;    left: 21%;  --dur: 8s;   --delay: 0.9s; }
  .cf-6 { width: 80px;  aspect-ratio: 1;   top: 50%;    right: 21%; --dur: 9.5s; --delay: 0.3s; }
  .cta-title {
    font-size: clamp(2.4rem, 6vw, 4.4rem);
    font-weight: 500; line-height: 0.94;
    letter-spacing: -0.045em; margin: 8px 0 18px;
  }
  .cta-desc { color: rgba(255,255,255,0.5); font-size: 0.98rem; margin-bottom: 36px; }
  .cta-actions { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; margin-bottom: 40px; }
  .cta-socials { display: flex; gap: 8px; justify-content: center; }
  .cta-socials a {
    width: 40px; height: 40px; border-radius: var(--r);
    border: 1px solid rgba(255,255,255,0.14);
    display: grid; place-items: center; transition: all 0.18s;
  }
  .cta-socials a:hover { background: var(--white); border-color: var(--white); }
  .cta-socials img { width: 16px; height: 16px; filter: brightness(0) invert(1); transition: filter 0.18s; }
  .cta-socials a:hover img { filter: none; }

  /* ── PANEL ── */
  .panel-backdrop {
    position: fixed; inset: 0; z-index: 200;
    background: rgba(10,10,10,0.28);
    opacity: 0; visibility: hidden;
    /* Matched to the sheet's 0.6s slide so they land together */
    transition: opacity 0.5s var(--ease), visibility 0.5s var(--ease);
  }
  .panel-backdrop.is-open { opacity: 1; visibility: visible; }
  .panel {
    position: fixed; top: 0; left: 0; right: 0; z-index: 210;
    background: rgba(255,255,255,0.62);
    backdrop-filter: blur(20px) saturate(140%);
    -webkit-backdrop-filter: blur(20px) saturate(140%);
    border-bottom: 1px solid rgba(207,207,211,0.6);
    max-height: 86vh; overflow-y: auto; -webkit-overflow-scrolling: touch;
    transform: translateY(-101%);
    will-change: transform;
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .panel.is-open { transform: translateY(0); }
  .panel-close {
    position: absolute; top: 20px; right: 24px;
    width: 36px; height: 36px; border-radius: var(--r);
    border: 1px solid var(--gray-200);
    display: grid; place-items: center;
    font-size: 0.88rem; z-index: 5; transition: all 0.18s;
  }
  .panel-close:hover { background: var(--black); color: var(--white); border-color: var(--black); }

  /* Drag handle (grab + pull up to close) */
  .panel-handle {
    position: sticky; bottom: 0; z-index: 6;
    display: flex; align-items: center; justify-content: center;
    height: 32px; cursor: grab; touch-action: none;
    background: transparent;
  }
  .panel-handle:active { cursor: grabbing; }
  .panel-handle span {
    width: 44px; height: 5px; border-radius: 999px;
    background: var(--gray-400); transition: background 0.15s, width 0.15s;
  }
  .panel-handle:hover span { background: var(--gray-600); width: 52px; }

  .panel-inner { max-width: var(--maxw); margin: 0 auto; padding: 64px 40px 40px; }

  /* Content cascades in as the sheet lands (keyframes so re-opens replay).
     Base state stays visible, so nothing vanishes during the exit slide. */
  @keyframes panelItemIn {
    from { opacity: 0; transform: translateY(12px); }
    to   { opacity: 1; transform: none; }
  }
  .panel.is-open .panel-inner > :global(*) {
    animation: panelItemIn 0.5s var(--ease-out) both;
  }
  .panel.is-open .panel-inner > :global(*:nth-child(1)) { animation-delay: 0.16s; }
  .panel.is-open .panel-inner > :global(*:nth-child(2)) { animation-delay: 0.22s; }
  .panel.is-open .panel-inner > :global(*:nth-child(3)) { animation-delay: 0.28s; }
  .panel.is-open .panel-inner > :global(*:nth-child(4)) { animation-delay: 0.34s; }
  .panel.is-open .panel-inner > :global(*:nth-child(5)) { animation-delay: 0.42s; }
  :global(.panel-tag) {
    font-size: 0.6rem; font-weight: 700; letter-spacing: 0.2em;
    text-transform: uppercase; color: var(--gray-400); margin-bottom: 12px; display: block;
  }
  .panel-inner h2 { font-size: clamp(1.8rem, 3.5vw, 2.8rem); font-weight: 500; letter-spacing: -0.035em; margin-bottom: 16px; }
  .panel-inner > p { color: var(--gray-600); font-size: 0.98rem; line-height: 1.7; max-width: 520px; margin-bottom: 36px; }
  :global(.panel-grid) {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: 1px; background: rgba(207,207,211,0.45); border: 1px solid rgba(207,207,211,0.5);
  }
  :global(.panel-card) {
    background: rgba(255,255,255,0.45); padding: 26px 26px 28px;
    display: flex; flex-direction: column; gap: 12px;
    transition: background 0.18s, color 0.18s;
  }
  :global(.panel-card:hover) { background: var(--black); color: var(--white); }
  :global(.pc-num) { font-size: 0.6rem; font-weight: 700; letter-spacing: 0.12em; color: var(--gray-400); }
  :global(.panel-card:hover .pc-num) { color: rgba(255,255,255,0.35); }
  :global(.panel-card h4) { font-size: 1.05rem; font-weight: 500; letter-spacing: -0.015em; line-height: 1.25; }

  /* Core drive — summary line beneath the capability grid */
  :global(.panel-drive) {
    display: flex; align-items: baseline; gap: 14px; flex-wrap: wrap;
    margin-top: 24px; padding-top: 22px;
    border-top: 1px solid rgba(207,207,211,0.6);
  }
  :global(.pd-label) {
    font-size: 0.6rem; font-weight: 700; letter-spacing: 0.2em;
    text-transform: uppercase; color: var(--gray-400); flex-shrink: 0;
  }
  :global(.pd-value) { font-size: 1rem; font-weight: 500; letter-spacing: -0.01em; color: var(--black); }

  /* ── RESPONSIVE (homepage-specific) ── */
  @media (max-width: 1024px) {
    .work-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 900px) {
    .cf-1, .cf-2, .cf-3, .cf-4 { width: 88px; }
    .cf-5, .cf-6 { width: 60px; }
    .hero-inner { grid-template-columns: 1fr; gap: 48px; }
    .hero-visual { max-width: 400px; }
    .studio-inner { grid-template-columns: 1fr; gap: 48px; }
    .highlight-inner { grid-template-columns: 1fr; gap: 40px; }
    :global(.panel-grid) { grid-template-columns: 1fr; }
    .feature-strip-inner { grid-template-columns: repeat(2, 1fr); }
    /* In 2-col mode, drop the right-edge line and separate the two rows */
    .feature-strip-item:nth-child(2n) { border-right: none; }
    .feature-strip-item:nth-child(-n+2) { border-bottom: 1px solid rgba(255,255,255,0.07); }
  }
  @media (max-width: 700px) {
    .work-grid { grid-template-columns: 1fr 1fr; }
    .stories-inner { flex-direction: column; align-items: flex-start; gap: 24px; padding: 56px 20px; }
    .scroll-cue { display: none; }
    /* Phones: corner tiles only, mirrored and tucked clear of the copy */
    .cf-5, .cf-6 { display: none; }
    .cf-1, .cf-2, .cf-3, .cf-4 { width: 64px; }
    .cf-1 { top: 5%;    left: 4%; }
    .cf-2 { top: 5%;    right: 4%; }
    .cf-3 { bottom: 5%; left: 4%; }
    .cf-4 { bottom: 5%; right: 4%; }
  }
  @media (max-width: 380px) {
    /* Keep the big display type from overflowing on the smallest phones */
    .hero-title { font-size: 2.7rem; }
    .work-grid { grid-template-columns: 1fr; }
    .hero { padding-top: calc(var(--header-h) + 48px); }
  }
</style>

<script is:inline data-astro-rerun>
(function () {
  const $ = (s, el = document) => el.querySelector(s);
  const $$ = (s, el = document) => [...el.querySelectorAll(s)];

  /* With the ClientRouter this script re-runs on each visit to this page;
     persistent listeners are scoped to `signal` and aborted before the swap. */
  const ac = new AbortController();
  const signal = ac.signal;
  let fsTimer = null;
  document.addEventListener('astro:before-swap', () => {
    if (fsTimer) clearInterval(fsTimer);
    ac.abort();
    document.body.style.overflow = '';
  }, { once: true });

  /* Scroll reveal is handled globally in Header.astro */

  /* Stat counters */
  function animateCount(el) {
    const target = +el.dataset.target;
    const dur = 1500;
    const start = performance.now();
    function tick(now) {
      const p = Math.min((now - start) / dur, 1);
      const eased = 1 - Math.pow(1 - p, 3);
      el.textContent = Math.floor(eased * target);
      if (p < 1) requestAnimationFrame(tick);
      else el.textContent = target;
    }
    requestAnimationFrame(tick);
  }
  const countObs = new IntersectionObserver((entries) => {
    entries.forEach((e) => { if (e.isIntersecting) { animateCount(e.target); countObs.unobserve(e.target); } });
  }, { threshold: 0.5 });
  $$('.stat-n').forEach((el) => countObs.observe(el));

  /* Feature strip: show icons, then roll each tile to its label/value (staggered).
     Loops every 30s — icons reappear, then roll back to the text. */
  const fsStrip = $('.feature-strip');
  if (fsStrip) {
    const flips = $$('.fs-flip', fsStrip);
    const setFlip = (show) => flips.forEach((el, i) =>
      setTimeout(() => el.classList.toggle('is-flipped', show), i * 200));
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let fsInView = false;
    let fsStarted = false;
    const fsObs = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        fsInView = e.isIntersecting;
        if (!fsStarted && fsInView) {
          fsStarted = true;
          setTimeout(() => setFlip(true), 500); // icons -> text on first view
          if (!reduceMotion) {
            fsTimer = setInterval(() => {
              if (!fsInView) return;                 // don't cycle off-screen
              setFlip(false);                        // show icons again
              setTimeout(() => setFlip(true), 1800); // then roll back to text
            }, 30000);
          }
        }
      });
    }, { threshold: 0.4 });
    fsObs.observe(fsStrip);
  }

  /* Panel */
  const PANEL_DATA = {
    design: {
      tag: 'Discipline', title: 'Design',
      body: 'The discipline of solving problems and creating functional, purposeful experiences.',
      items: ['Brand Design', 'UI/UX Design', 'Product Design', 'Graphic Design', 'Motion Design', 'Creative Strategy'],
      drive: 'Clarity, function, communication.',
    },
    art: {
      tag: 'Discipline', title: 'Art',
      body: 'The discipline of expression, imagination, and creativity.',
      items: ['Illustration', 'Digital Art', 'Painting', 'Concept Art', 'Photography', 'Visual Storytelling'],
      drive: 'Expression, emotion, originality.',
    },
    fashion: {
      tag: 'Discipline', title: 'Fashion',
      body: 'The discipline of personal identity and aesthetics through style.',
      items: ['Clothing Design', 'Styling', 'Fashion Branding', 'Streetwear', 'Accessories', 'Fashion Photography'],
      drive: 'Identity, culture, self-expression.',
    },
    development: {
      tag: 'Discipline', title: 'Development',
      body: 'The discipline of building systems, tools, and technology.',
      items: ['Software Development', 'Mobile Applications', 'Web Applications', 'Artificial Intelligence', 'Robotics', 'Automation', 'Product Engineering'],
      drive: 'Innovation, logic, creation.',
    },
  };

  const panel = $('#panel');
  const panelBackdrop = $('#panelBackdrop');
  const panelInner = $('#panelInner');
  const panelClose = $('#panelClose');
  let lastFocused = null;

  function openPanel(key, trigger) {
    const data = PANEL_DATA[key];
    if (!data) return;
    lastFocused = trigger || document.activeElement;
    panelInner.innerHTML = `
      <span class="panel-tag">${data.tag}</span>
      <h2>${data.title}</h2>
      <p>${data.body}</p>
      <div class="panel-grid">
        ${data.items.map((it, i) => `
          <div class="panel-card">
            <div class="pc-num">${String(i + 1).padStart(2, '0')}</div>
            <h4>${it}</h4>
          </div>`).join('')}
      </div>
      <div class="panel-drive">
        <span class="pd-label">Core drive</span>
        <span class="pd-value">${data.drive}</span>
      </div>`;
    panel.classList.add('is-open');
    panelBackdrop.classList.add('is-open');
    panel.scrollTop = 0;
    document.body.style.overflow = 'hidden';
    panelClose?.focus();
  }

  function closePanel() {
    if (!panel.classList.contains('is-open')) return;
    panel.classList.remove('is-open');
    panelBackdrop.classList.remove('is-open');
    document.body.style.overflow = '';
    if (lastFocused) { lastFocused.focus(); lastFocused = null; }
  }

  /* Panel work cards: clickable + keyboard-operable (Enter / Space).
     Cards without [data-panel] (e.g. Inside Stories) are plain links. */
  $$('.work-card[data-panel]').forEach((card) => {
    card.setAttribute('role', 'button');
    card.setAttribute('tabindex', '0');
    const open = () => openPanel(card.dataset.panel, card);
    card.addEventListener('click', open);
    card.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(); }
    });
  });
  panelClose?.addEventListener('click', closePanel);
  panelBackdrop?.addEventListener('click', closePanel);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') { closePanel(); return; }
    /* Focus trap: while the panel dialog is open, Tab cycles inside it
       instead of escaping into the page behind the backdrop. */
    if (e.key !== 'Tab' || !panel.classList.contains('is-open')) return;
    const focusables = panel.querySelectorAll('button, a[href], [tabindex="0"]');
    if (!focusables.length) return;
    const first = focusables[0];
    const last = focusables[focusables.length - 1];
    if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
    else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
  }, { signal });

  /* Drag the handle up to dismiss the panel */
  const panelHandle = $('#panelHandle');
  let drag = null;
  panelHandle?.addEventListener('pointerdown', (e) => {
    drag = { startY: e.clientY, h: panel.offsetHeight, delta: 0 };
    panel.style.transition = 'none';
    panelHandle.setPointerCapture(e.pointerId);
  });
  panelHandle?.addEventListener('pointermove', (e) => {
    if (!drag) return;
    let d = e.clientY - drag.startY;
    if (d > 0) d *= 0.25;                 // resist downward pull
    drag.delta = d;
    panel.style.transform = `translateY(${d}px)`;
  });
  function endDrag() {
    if (!drag) return;
    const shouldClose = drag.delta < -Math.min(120, drag.h * 0.3);
    panel.style.transition = '';          // restore the slide animation
    if (shouldClose) closePanel();
    panel.style.transform = '';           // animate from current pos to rest/closed
    drag = null;
  }
  panelHandle?.addEventListener('pointerup', endDrag);
  panelHandle?.addEventListener('pointercancel', endDrag);
  panelHandle?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); closePanel(); }
  });

  /* Anchor scrolling is native: html { scroll-behavior: smooth } +
     scroll-padding-top handles the fixed-header offset and respects
     prefers-reduced-motion — no JS needed. */
})();
</script>

</BaseLayout>
