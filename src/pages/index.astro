---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) =>
  new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);
---

<BaseLayout title="SND — Think It, Let's Create It">

<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700&display=swap');

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --snd-dark:   #343940;
    --snd-light:  #CFCFD3;
    --snd-black:  #0d0d0d;
    --snd-white:  #ffffff;
    --font-display: 'Skia', 'Inter', 'Helvetica Neue', system-ui, sans-serif;
    --font-body:    'Skia', 'Inter', 'Helvetica Neue', system-ui, sans-serif;
    --header-h:   52px;
  }

  /* ─── HEADER ─── */
  .site-header {
    position: fixed;
    top: 0; left: 0; right: 0;
    height: var(--header-h);
    display: flex;
    align-items: center;
    justify-content: center;
    background: #ffffff;
    border-bottom: 1px solid rgba(52,57,64,0.14);
    z-index: 100;
  }

  .logo-link { display: flex; align-items: center; text-decoration: none; }
  .logo-img  { height: 30px; width: auto; }

  /* ─── INFO PANEL ─── */
  .info-panel {
    position: fixed;
    top: var(--header-h);
    left: 0; right: 0;
    z-index: 95;
    background: #ffffff;
    border-bottom: 1px solid rgba(52,57,64,0.14);
    box-shadow: none;
    max-height: 82vh;
    overflow-y: auto;
    transform: translateY(-102%);
    transition: transform 0.48s cubic-bezier(0.4, 0, 0.2, 1);
    will-change: transform;
    -webkit-overflow-scrolling: touch;
  }

  .info-panel.open { transform: translateY(0); }

  .panel-backdrop {
    position: fixed;
    inset: 0;
    top: var(--header-h);
    z-index: 94;
    background: rgba(0,0,0,0);
    pointer-events: none;
    transition: background 0.45s ease;
  }

  .panel-backdrop.active {
    background: rgba(0,0,0,0.08);
    pointer-events: auto;
  }

  .panel-inner {
    max-width: 1160px;
    margin: 0 auto;
    padding: 2.6rem 3rem 3rem;
    position: relative;
  }

  .panel-close {
    position: sticky;
    top: 0;
    float: right;
    margin-bottom: -30px;
    background: rgba(255,255,255,0.9);
    border: 1px solid rgba(52,57,64,0.14);
    cursor: pointer;
    width: 30px; height: 30px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--snd-dark);
    font-size: 0.95rem;
    opacity: 0.6;
    transition: opacity 0.2s, background 0.2s;
    z-index: 10;
  }

  .panel-close:hover { opacity: 1; background: rgba(52,57,64,0.06); }

  .panel-content { display: none; }
  .panel-content.active { display: block; }

  /* ── Shared panel label/link ── */
  .panel-tag {
    display: inline-block;
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #aaa;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .panel-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--snd-black);
    text-decoration: none;
    border-bottom: 1px solid rgba(13,13,13,0.3);
    padding-bottom: 0.12rem;
    transition: opacity 0.2s;
  }

  .panel-link:hover { opacity: 0.5; border-color: transparent; }

  /* ══ ABOUT PANEL ══ */
  .about-hero {
    margin-bottom: 2.4rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid rgba(52,57,64,0.08);
  }

  .about-hero h1 {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 4vw, 3.6rem);
    font-weight: 400;
    color: var(--snd-black);
    line-height: 1.05;
    letter-spacing: -0.04em;
    margin-bottom: 0.75rem;
  }

  .about-hero p {
    font-size: 0.9rem;
    color: #6b7280;
    max-width: 540px;
    line-height: 1.7;
  }

  .about-mv-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .about-mv-card {
    background: #ffffff;
    border: 1px solid rgba(52,57,64,0.12);
    border-radius: 4px;
    padding: 1.4rem 1.6rem;
  }

  .about-mv-card .mv-label {
    font-size: 0.6rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #aaa;
    font-weight: 600;
    margin-bottom: 0.6rem;
  }

  .about-mv-card h3 {
    font-size: 1.1rem;
    font-weight: 500;
    color: var(--snd-black);
    margin-bottom: 0.55rem;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .about-mv-card p {
    font-size: 0.8rem;
    color: #6b7280;
    line-height: 1.7;
  }

  .about-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    padding: 1.5rem 0;
    border-top: 1px solid rgba(52,57,64,0.09);
    border-bottom: 1px solid rgba(52,57,64,0.09);
    margin-bottom: 2.2rem;
  }

  .about-stat { text-align: center; }

  .about-stat .stat-n {
    display: block;
    font-size: 2rem;
    font-weight: 400;
    color: var(--snd-black);
    letter-spacing: -0.05em;
    line-height: 1;
    margin-bottom: 0.3rem;
  }

  .about-stat .stat-l {
    font-size: 0.65rem;
    color: #b0b8c4;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .about-areas-header {
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #aaa;
    font-weight: 600;
    margin-bottom: 1rem;
  }

  .about-areas-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .about-area-card {
    border: 1px solid rgba(52,57,64,0.12);
    border-radius: 4px;
    padding: 1.4rem;
    background: #ffffff;
    transition: background 0.3s, border-color 0.3s;
  }

  .about-area-card:hover {
    background: #0d0d0d;
    border-color: #0d0d0d;
  }

  .about-area-card:hover .area-num,
  .about-area-card:hover h4,
  .about-area-card:hover p { color: #fff; }

  .area-num {
    font-size: 0.72rem;
    font-weight: 600;
    color: #c0c0c0;
    margin-bottom: 0.9rem;
    transition: color 0.3s;
  }

  .about-area-card h4 {
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--snd-black);
    margin-bottom: 0.6rem;
    letter-spacing: -0.02em;
    transition: color 0.3s;
  }

  .about-area-card p {
    font-size: 0.78rem;
    color: #6b7280;
    line-height: 1.65;
    margin-bottom: 0.9rem;
    transition: color 0.3s;
  }

  /* ══ JOURNAL PANEL ══ */
  .journal-header {
    display: grid;
    grid-template-columns: 210px 1fr;
    gap: 3rem;
    align-items: start;
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid rgba(52,57,64,0.08);
  }

  .journal-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 3vw, 2.8rem);
    font-weight: 400;
    color: var(--snd-black);
    line-height: 1.05;
    letter-spacing: -0.04em;
    display: block;
    margin-bottom: 1.2rem;
  }

  .journal-desc {
    font-size: 0.82rem;
    color: #6b7280;
    line-height: 1.7;
    max-width: 480px;
  }

  .journal-posts-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .journal-post-link {
    display: block;
    text-decoration: none;
    color: inherit;
    border: 1px solid rgba(52,57,64,0.12);
    border-radius: 4px;
    padding: 1.3rem 1.4rem;
    transition: border-color 0.2s;
  }

  .journal-post-link:hover {
    border-color: var(--snd-black);
  }

  .journal-post-date {
    font-size: 0.62rem;
    color: #b0b8c4;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 0.5rem;
  }

  .journal-post-title {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--snd-black);
    line-height: 1.35;
    margin-bottom: 0.5rem;
    letter-spacing: -0.01em;
  }

  .journal-post-desc {
    font-size: 0.75rem;
    color: #8a9bb0;
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .journal-empty {
    padding: 2rem;
    text-align: center;
    color: #aaa;
    font-size: 0.82rem;
    border: 1px dashed rgba(52,57,64,0.15);
    border-radius: 8px;
  }

  /* ══ PRODUCTS PANEL ══ */
  .products-header {
    display: grid;
    grid-template-columns: 210px 1fr;
    gap: 3rem;
    align-items: start;
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid rgba(52,57,64,0.08);
  }

  .products-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 3vw, 2.8rem);
    font-weight: 400;
    color: var(--snd-black);
    line-height: 1.05;
    letter-spacing: -0.04em;
    display: block;
    margin-bottom: 1.2rem;
  }

  .products-desc {
    font-size: 0.82rem;
    color: #6b7280;
    line-height: 1.7;
    max-width: 480px;
  }

  .products-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .product-panel-card {
    border: 1px solid rgba(52,57,64,0.12);
    border-radius: 4px;
    padding: 1.4rem;
    background: #ffffff;
    transition: background 0.3s, border-color 0.3s;
  }

  .product-panel-card:hover {
    background: #0d0d0d;
    border-color: #0d0d0d;
  }

  .product-panel-card:hover h4,
  .product-panel-card:hover p { color: #fff; }

  .product-panel-card h4 {
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--snd-black);
    margin-bottom: 0.55rem;
    letter-spacing: -0.02em;
    transition: color 0.3s;
  }

  .product-panel-card p {
    font-size: 0.78rem;
    color: #6b7280;
    line-height: 1.65;
    margin-bottom: 0.9rem;
    transition: color 0.3s;
  }

  /* ══ DESIGN PANEL ══ */
  .design-panel-layout {
    display: grid;
    grid-template-columns: 210px 1fr;
    gap: 3.5rem;
    align-items: start;
  }

  .design-panel-left {}

  .design-panel-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 3vw, 2.8rem);
    font-weight: 400;
    color: var(--snd-black);
    line-height: 1.05;
    letter-spacing: -0.04em;
    display: block;
    margin-bottom: 1.2rem;
  }

  .panel-cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem 2.5rem;
  }

  .panel-col {
    border-top: 1px solid rgba(52,57,64,0.1);
    padding-top: 1rem;
  }

  .panel-col h4 {
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--snd-black);
    margin-bottom: 0.55rem;
    letter-spacing: -0.01em;
  }

  .panel-col p {
    font-size: 0.78rem;
    color: #7a828c;
    line-height: 1.7;
  }


  /* ─── CANVAS WRAP ─── */
  .canvas-wrap {
    position: fixed;
    top: var(--header-h);
    left: 0; right: 0; bottom: 0;
    overflow: hidden;
    background-color: #f9f9f9;
    background-image: radial-gradient(circle, rgba(52,57,64,0.11) 1px, transparent 1px);
    background-size: 28px 28px;
  }

  .cards-grid {
    position: relative;
    width: 100%;
    height: 100%;
  }

  /* ─── CARD BASE ─── */
  .card {
    position: absolute;
    left: var(--cx);
    top: var(--cy);
    width: var(--w, 160px);
    transform: translate(-50%, -50%);
    z-index: 1;
    cursor: pointer;
    user-select: none;
  }

  .card:hover { z-index: 10; }

  .card.dragging {
    z-index: 100;
    cursor: grabbing !important;
  }

  .card.dragging .card-img-wrap {
    box-shadow: 0 24px 56px rgba(0,0,0,0.2);
  }

  .card-inner {
    display: block;
    transition: transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .card.dragging .card-inner { transition: none; }
  .card:hover .card-inner { transform: translateY(-6px); }

  .card-img-wrap {
    width: 100%;
    aspect-ratio: 4 / 3;
    border-radius: 4px;
    overflow: hidden;
    background: var(--snd-light);
    border: 1px solid rgba(52,57,64,0.13);
    box-shadow: none;
  }

  .card:hover .card-img-wrap {
    border-color: rgba(52,57,64,0.3);
  }

  .card.dragging .card-img-wrap {
    box-shadow: 0 16px 40px rgba(0,0,0,0.14);
    border-color: rgba(52,57,64,0.2);
  }

  .card-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }

  .card:hover .card-img-wrap img { transform: scale(1.04); }

  .card-body { padding: 0.5rem 0.05rem 0; text-align: center; }

  .card-title {
    display: -webkit-box;
    font-family: var(--font-display);
    font-size: 0.88rem;
    font-weight: 400;
    color: var(--snd-black);
    line-height: 1.25;
    overflow: hidden;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  /* ─── CENTER LOGO ─── */
  .canvas-logo-center {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    z-index: 2;
    pointer-events: none;
  }

  .canvas-center-canvas { display: block; }

  /* ─── TYPEWRITER ─── */
  .canvas-typewriter {
    position: absolute;
    left: 6%;
    top: 50%;
    transform: translateY(-50%);
    width: 36%;
    pointer-events: none;
    user-select: none;
    z-index: 3;
  }

  .typewriter-label {
    display: block;
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #b0b8c4;
    margin-bottom: 1rem;
    font-weight: 600;
  }

  .typewriter-text {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 1.9vw, 1.65rem);
    font-weight: 300;
    color: var(--snd-black);
    line-height: 1.45;
    letter-spacing: -0.025em;
    min-height: 3em;
  }

  .typewriter-cursor {
    display: inline-block;
    width: 1.5px;
    height: 0.9em;
    background: var(--snd-black);
    margin-left: 2px;
    vertical-align: middle;
    animation: blink 0.75s step-end infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0; }
  }

  /* ─── BOTTOM BAR ─── */
  .canvas-bottom-bar {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-bottom: 1.2rem;
    pointer-events: none;
  }

  .canvas-credit {
    display: flex;
    gap: 1.5rem;
    align-items: center;
    font-size: 0.58rem;
    color: rgba(52,57,64,0.28);
    letter-spacing: 0.08em;
    white-space: nowrap;
  }

  .canvas-credit a {
    color: rgba(52,57,64,0.28);
    text-decoration: none;
    pointer-events: auto;
    transition: color 0.2s;
  }

  .canvas-credit a:hover { color: rgba(52,57,64,0.6); }

  /* ─── MOBILE ─── */
  @media (max-width: 768px) {
    .canvas-wrap {
      position: static;
      overflow: visible;
      background-image: none;
      background-color: #f9f9f9;
      padding: calc(var(--header-h) + 1.5rem) 1.2rem 2rem;
    }

    .cards-grid {
      position: static;
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
      height: auto;
    }

    .card {
      position: static !important;
      left: auto !important;
      top: auto !important;
      width: 100% !important;
      transform: none !important;
    }

    .canvas-logo-center { display: none; }
    .card:hover .card-inner { transform: none; }

    .canvas-bottom-bar {
      position: static;
      padding: 2rem 0 1rem;
      pointer-events: auto;
    }

    .canvas-credit { pointer-events: auto; }

    .panel-inner { padding: 1.5rem 1.2rem 2rem; }
    .panel-close { margin-bottom: -24px; }

    .about-mv-grid { grid-template-columns: 1fr; gap: 1rem; }
    .about-stats { grid-template-columns: repeat(3, 1fr); }
    .about-areas-grid { grid-template-columns: 1fr; gap: 1rem; }

    .journal-header { grid-template-columns: 1fr; gap: 1rem; }
    .journal-posts-grid { grid-template-columns: 1fr; }

    .products-header { grid-template-columns: 1fr; gap: 1rem; }
    .products-grid { grid-template-columns: 1fr; gap: 1rem; }

    .design-panel-layout { grid-template-columns: 1fr; gap: 1.5rem; }
    .panel-cols { grid-template-columns: 1fr 1fr; gap: 1.2rem; }
  }
</style>

<!-- ─── HEADER ─── -->
<header class="site-header">
  <a href="/" class="logo-link">
    <img src="/snd.png" alt="SND" class="logo-img" onerror="this.style.display='none';" />
  </a>
</header>

<!-- ─── INFO PANEL ─── -->
<div class="info-panel" id="infoPanel" role="region" aria-label="Section info">
  <div class="panel-inner">
    <button class="panel-close" id="panelClose" aria-label="Close">&#x2715;</button>

    <!-- ── ABOUT SND ── -->
    <div class="panel-content" data-panel="about">
      <div class="about-hero">
        <span class="panel-tag">Studio</span>
        <h1>Think It.<br/>Create It.</h1>
        <p>We turn ideas into reality through thoughtful design, innovative development, and genuine collaboration.</p>
      </div>

      <div class="about-mv-grid">
        <div class="about-mv-card">
          <div class="mv-label">Our Vision</div>
          <h3>To become a leading African brand</h3>
          <p>Building intelligent, creative, and culturally relevant solutions through the integrated disciplines of technology, art, and design — demonstrating that world-class digital products can originate from Uganda and serve both local and global audiences.</p>
        </div>
        <div class="about-mv-card">
          <div class="mv-label">Our Mission</div>
          <h3>Simplify complex problems</h3>
          <p>Through thoughtful, well-crafted systems that combine functional design, artificial intelligence, and genuine human understanding. Every product — whether a mobile application, a brand identity, or a physical notebook — must serve a clear purpose and provide a seamless user experience.</p>
        </div>
      </div>

      <div class="about-stats">
        <div class="about-stat">
          <span class="stat-n">10+</span>
          <span class="stat-l">Projects Completed</span>
        </div>
        <div class="about-stat">
          <span class="stat-n">15+</span>
          <span class="stat-l">Happy Clients</span>
        </div>
        <div class="about-stat">
          <span class="stat-n">3+</span>
          <span class="stat-l">Years of Experience</span>
        </div>
      </div>

      <div class="about-areas-header">Core Operating Areas</div>
      <div class="about-areas-grid">
        <div class="about-area-card">
          <div class="area-num">01</div>
          <h4>Technology</h4>
          <p>Building applications, tools, and platforms designed to solve real-world organizational and productivity problems. From concept to launch, SND develops scalable digital systems with long-term usability in mind.</p>
        </div>
        <div class="about-area-card">
          <div class="area-num">02</div>
          <h4>Art &amp; Design</h4>
          <p>Creating visual identity systems, interfaces, motion graphics, and brand experiences that combine clarity with aesthetics. Every design decision is made to strengthen usability, communication, and perception.</p>
        </div>
        <div class="about-area-card">
          <div class="area-num">03</div>
          <h4>Fashion &amp; Physical Goods</h4>
          <p>Expanding the SND ecosystem through thoughtfully designed merchandise and physical products that increase visibility, strengthen identity, and create additional revenue channels.</p>
        </div>
      </div>
    </div>

    <!-- ── DESIGN & CREATIVE ── -->
    <div class="panel-content" data-panel="design">
      <div class="design-panel-layout">
        <div class="design-panel-left">
          <span class="panel-tag">Services</span>
          <span class="design-panel-title">Design &amp; Creative</span>
        </div>
        <div class="panel-cols">
          <div class="panel-col">
            <h4>Branding</h4>
            <p>Visual identity systems, logos, and brand experiences that communicate clearly and build lasting recognition.</p>
          </div>
          <div class="panel-col">
            <h4>UI / UX</h4>
            <p>Interfaces designed for humans first — intuitive, accessible, and built to serve a clear purpose on every screen.</p>
          </div>
          <div class="panel-col">
            <h4>Motion</h4>
            <p>Bring ideas to life through animation, motion graphics, and dynamic storytelling that captures attention.</p>
          </div>
        </div>
      </div>
    </div>

    <!-- ── PRODUCTS ── -->
    <div class="panel-content" data-panel="products">
      <div class="products-header">
        <div>
          <span class="panel-tag">Physical Goods</span>
          <span class="products-title">Products</span>
        </div>
