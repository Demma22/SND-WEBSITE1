---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) =>
  new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);

const journalPanelCards = [
  ...sortedPosts.slice(0, 2).map((p, i) => ({
    num: String(i + 1).padStart(2, '0'),
    h: p.data.title,
    p: p.data.description ?? '',
    href: `/blog/${p.id}`,
  })),
  { num: '03', h: 'More coming soon', p: 'New perspectives on design, technology, and culture drop regularly.', href: null },
];
---

<BaseLayout title="SND: Think It. Create It.">

<Header homepage={true} />

<!-- Panel backdrop + panel -->
<div class="panel-backdrop" id="panelBackdrop"></div>
<aside class="panel" id="panel" role="dialog" aria-modal="true" aria-label="Section details">
  <button class="panel-close" id="panelClose" aria-label="Close panel">&#x2715;</button>
  <div class="panel-inner" id="panelInner"></div>
</aside>

<main id="main" tabindex="-1">

<!-- ── HERO ── -->
<section class="hero" id="home">
  <div class="hero-bg"></div>
  <div class="container hero-inner">
    <div class="hero-content reveal">
      <span class="eyebrow">A creative studio from Uganda</span>
      <h1 class="hero-title">Think It.<br />Create It.</h1>
      <p class="hero-subtitle">
        We turn ideas into reality through thoughtful design, innovative development,
        and genuine collaboration. Building intelligent, creative, and culturally relevant solutions.
      </p>
      <div class="hero-cta">
        <a href="#work"    class="btn btn--dark">View our work <span class="arrow">&#8594;</span></a>
        <a href="#contact" class="btn btn--ghost-dark">Work with us</a>
      </div>
    </div>
    <div class="hero-visual reveal">
      <div class="hero-img-wrap">
        <img src="/art_tech.jpg" alt="SND creative work" />
      </div>
      <div class="hero-badge">
        <span class="hero-badge-num">10+</span>
        <span class="hero-badge-label">Projects shipped</span>
      </div>
    </div>
  </div>
  <div class="scroll-cue">
    <span class="scroll-line"></span>
  </div>
</section>

<!-- ── FEATURE STRIP ── -->
<section class="feature-strip">
  <div class="container feature-strip-inner">
    <div class="feature-strip-item">
      <span class="fs-label">Design</span>
      <span class="fs-value">Human-first</span>
    </div>
    <div class="feature-strip-item">
      <span class="fs-label">Built in</span>
      <span class="fs-value">Uganda</span>
    </div>
    <div class="feature-strip-item">
      <span class="fs-label">Disciplines</span>
      <span class="fs-value">Tech &middot; Art &middot; Goods</span>
    </div>
    <div class="feature-strip-item">
      <span class="fs-label">Since</span>
      <span class="fs-value">2023</span>
    </div>
  </div>
</section>

<!-- ── WORK / CARDS ── -->
<section class="work" id="work">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">Selected work</span>
      <h2 class="section-title">Explore the studio.</h2>
      <p class="section-desc">Three disciplines, one philosophy. Click any card to dive in.</p>
    </div>
    <div class="work-grid">
      <article class="work-card reveal" data-panel="studio">
        <div class="work-card-img">
          <img src="/art_tech.jpg" alt="About SND" />
          <span class="work-card-num">01</span>
        </div>
        <div class="work-card-body">
          <h3>About SND</h3>
          <p>The story, the mission, the people behind the studio.</p>
          <span class="work-card-cta">Explore <span class="arrow">&#8594;</span></span>
        </div>
      </article>
      <article class="work-card reveal" data-panel="services">
        <div class="work-card-img">
          <img src="/design.jpg" alt="Design & Creative" />
          <span class="work-card-num">02</span>
        </div>
        <div class="work-card-body">
          <h3>Design &amp; Creative</h3>
          <p>Branding, UI/UX, and motion that communicates clearly.</p>
          <span class="work-card-cta">Explore <span class="arrow">&#8594;</span></span>
        </div>
      </article>
      <article class="work-card reveal" data-panel="products">
        <div class="work-card-img">
          <img src="/fashion.jpg" alt="Products" />
          <span class="work-card-num">03</span>
        </div>
        <div class="work-card-body">
          <h3>Products</h3>
          <p>Physical goods that extend the studio into the world.</p>
          <span class="work-card-cta">Explore <span class="arrow">&#8594;</span></span>
        </div>
      </article>
      <article class="work-card reveal" data-panel="journal">
        <div class="work-card-img">
          <img src="/digital.jpg" alt="The Journal" />
          <span class="work-card-num">04</span>
        </div>
        <div class="work-card-body">
          <h3>The Journal</h3>
          <p>Ideas and perspectives on design, technology, and culture.</p>
          <span class="work-card-cta">Explore <span class="arrow">&#8594;</span></span>
        </div>
      </article>
    </div>
  </div>
</section>

<!-- ── STUDIO ── -->
<section class="studio" id="studio">
  <div class="container studio-inner">
    <div class="studio-copy reveal">
      <span class="eyebrow eyebrow--light">The studio</span>
      <h2 class="section-title section-title--light">
        Building world-class<br />products from Uganda.
      </h2>
      <p class="studio-lead">
        SND is a creative studio combining technology, art, and design to build
        intelligent, culturally relevant solutions. We believe world-class digital
        products can originate from anywhere and serve both local and global audiences.
      </p>
      <div class="studio-mv">
        <div class="mv-card">
          <span class="mv-label">Our Vision</span>
          <h4>To become a leading African brand</h4>
          <p>Demonstrating that world-class digital products can originate from Uganda and serve both local and global audiences.</p>
        </div>
        <div class="mv-card">
          <span class="mv-label">Our Mission</span>
          <h4>Simplify complex problems</h4>
          <p>Through thoughtful, well-crafted systems that combine functional design, artificial intelligence, and genuine human understanding.</p>
        </div>
      </div>
    </div>
    <div class="studio-visual reveal">
      <div class="studio-img-main">
        <img src="/physical.jpg" alt="SND physical goods" />
      </div>
      <div class="studio-stats">
        <div class="stat">
          <span class="stat-n" data-target="10">0</span><span class="stat-plus">+</span>
          <span class="stat-l">Projects</span>
        </div>
        <div class="stat">
          <span class="stat-n" data-target="15">0</span><span class="stat-plus">+</span>
          <span class="stat-l">Clients</span>
        </div>
        <div class="stat">
          <span class="stat-n" data-target="3">0</span><span class="stat-plus">+</span>
          <span class="stat-l">Years</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ── SERVICES ── -->
<section class="services" id="services">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">What we do</span>
      <h2 class="section-title">Three disciplines, one standard.</h2>
    </div>
    <div class="services-grid">
      <div class="service-card reveal">
        <span class="service-num">01</span>
        <div class="service-icon-wrap"><img src="/tech.jpg" alt="Technology" /></div>
        <h3>Technology</h3>
        <p>Building applications, tools, and platforms designed to solve real-world organizational and productivity problems. From concept to launch, scalable digital systems with long-term usability.</p>
      </div>
      <div class="service-card reveal">
        <span class="service-num">02</span>
        <div class="service-icon-wrap"><img src="/design.jpg" alt="Art & Design" /></div>
        <h3>Art &amp; Design</h3>
        <p>Creating visual identity systems, interfaces, motion graphics, and brand experiences that combine clarity with aesthetics. Every decision strengthens usability, communication, and perception.</p>
      </div>
      <div class="service-card reveal">
        <span class="service-num">03</span>
        <div class="service-icon-wrap"><img src="/fashion.jpg" alt="Fashion & Physical Goods" /></div>
        <h3>Fashion &amp; Physical Goods</h3>
        <p>Expanding the SND ecosystem through thoughtfully designed merchandise and physical products that increase visibility, strengthen identity, and create additional revenue channels.</p>
      </div>
    </div>
  </div>
</section>

<!-- ── HIGHLIGHT / NOTEBOOK ── -->
<section class="highlight">
  <div class="container highlight-inner">
    <div class="highlight-img reveal">
      <img src="/physical.jpg" alt="The Lineless Notebook" />
    </div>
    <div class="highlight-copy reveal">
      <span class="eyebrow">Today's highlight &middot; Physical Goods</span>
      <h2 class="section-title">The Lineless Notebook.</h2>
      <p class="highlight-desc">
        No rules, just space. A clean, minimal notebook designed for creative minds.
        Sketch, write, and think freely without constraints.
      </p>
      <a href="/products" class="btn btn--dark">Shop now <span class="arrow">&#8594;</span></a>
    </div>
  </div>
</section>

<!-- ── JOURNAL ── -->
<section class="journal" id="journal">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">The Journal</span>
      <h2 class="section-title">Ideas worth sharing.</h2>
      <p class="section-desc">Stories and perspectives on design, technology, and culture.</p>
    </div>
    <div class="journal-grid">
      {sortedPosts.map((post) => (
        <a href={`/blog/${post.id}`} class="journal-card reveal">
          <div class="journal-card-img">
            <img src={post.data.image ?? '/digital.jpg'} alt={post.data.title} />
          </div>
          <div class="journal-card-body">
            <span class="journal-date">{post.data.pubDate} &middot; SND Team</span>
            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>
            <span class="journal-cta">Read more <span class="arrow">&#8594;</span></span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- ── CTA ── -->
<section class="cta" id="contact">
  <div class="container cta-inner reveal">
    <span class="eyebrow eyebrow--light">Let's build something</span>
    <h2 class="cta-title">Have a project<br />in mind?</h2>
    <p class="cta-desc">Think it. Let's create it together.</p>
    <div class="cta-actions">
      <a href="mailto:hello@sndstudio-ug.com" class="btn btn--light">hello@sndstudio-ug.com <span class="arrow">&#8594;</span></a>
      <a href="tel:+256742072661" class="btn btn--ghost-light">+256 742 072 661</a>
    </div>
    <div class="cta-socials">
      <a href="https://instagram.com/sndstudio.ug" aria-label="Instagram" target="_blank" rel="noopener"><img src="/instagram.svg" alt="Instagram" /></a>
      <a href="https://tiktok.com/@sndstudio.ug"   aria-label="TikTok"    target="_blank" rel="noopener"><img src="/tiktok.svg"    alt="TikTok" /></a>
      <a href="https://x.com/sndstudio_ug"          aria-label="X"         target="_blank" rel="noopener"><img src="/x.svg"         alt="X" /></a>
      <a href="https://threads.net/@sndstudio.ug"   aria-label="Threads"   target="_blank" rel="noopener"><img src="/threads.svg"   alt="Threads" /></a>
      <a href="https://pinterest.com/sndstudio_ug"  aria-label="Pinterest" target="_blank" rel="noopener"><img src="/pinterest.svg" alt="Pinterest" /></a>
    </div>
  </div>
</section>

</main>

<!-- ── FOOTER ── -->
<Footer />

<style>

  /* Shared tokens, reset, header, buttons, labels & reveal now live in
     src/styles/app.css. This block holds only homepage-specific styles. */

  .section-head { text-align: center; max-width: 560px; margin: 0 auto 56px; }
  .section-title {
    font-size: clamp(2rem, 4.5vw, 3.2rem);
    font-weight: 500; line-height: 1.02; letter-spacing: -0.035em;
  }
  .section-title--light { color: var(--white); }
  .section-desc { color: var(--gray-600); margin-top: 14px; font-size: 0.96rem; }

  /* ── HERO ── */
  .hero {
    padding: calc(var(--header-h) + 80px) 0 80px;
    position: relative; overflow: hidden;
  }
  .hero-bg {
    position: absolute; inset: 0; z-index: 0;
    background-image: radial-gradient(circle, rgba(0,0,0,0.5) 0.9px, transparent 0.9px);
    background-size: 8rem 8rem; background-attachment: fixed;
    mask-image: radial-gradient(ellipse 100% 80% at 50% 0%, #000 30%, transparent 85%);
    -webkit-mask-image: radial-gradient(ellipse 100% 80% at 50% 0%, #000 30%, transparent 85%);
  }
  .hero-inner {
    position: relative; z-index: 1;
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 64px; align-items: center;
  }
  .hero-content { max-width: 560px; }
  .hero-title {
    font-size: clamp(3rem, 6.5vw, 5.4rem);
    font-weight: 500; line-height: 0.94;
    letter-spacing: -0.045em; margin-bottom: 24px;
  }
  .hero-subtitle {
    font-size: 0.98rem; color: var(--gray-600);
    line-height: 1.72; margin-bottom: 32px; max-width: 420px;
  }
  .hero-cta { display: flex; gap: 10px; flex-wrap: wrap; }
  .hero-visual { position: relative; }
  .hero-img-wrap {
    border-radius: var(--r); overflow: hidden;
    aspect-ratio: 4/5; border: 1px solid var(--gray-200);
  }
  .hero-img-wrap img {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform 0.6s var(--ease);
  }
  .hero-img-wrap:hover img { transform: scale(1.03); }
  .hero-badge {
    position: absolute; bottom: 24px; left: -20px;
    background: var(--white); border: 1px solid var(--gray-200);
    border-radius: var(--r); padding: 14px 18px;
    display: flex; flex-direction: column;
  }
  .hero-badge-num { font-size: 1.8rem; font-weight: 800; line-height: 1; letter-spacing: -0.04em; }
  .hero-badge-label {
    font-size: 0.6rem; font-weight: 700; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--gray-400); margin-top: 4px;
  }
  .scroll-cue {
    position: absolute; bottom: 28px; left: 32px;
    display: flex; align-items: center; gap: 12px;
    font-size: 0.6rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--gray-400);
  }
  .scroll-line { width: 40px; height: 1px; background: var(--gray-400); }

  /* ── FEATURE STRIP ── */
  .feature-strip { background: var(--black); color: var(--white); position: relative; overflow: hidden; }
  .feature-strip::before {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background-image: radial-gradient(circle, rgba(255,255,255,0.5) 0.9px, transparent 0.9px);
    background-size: 8rem 8rem; background-attachment: fixed; opacity: 0.32;
  }
  .feature-strip-inner {
    position: relative; z-index: 1;
    display: grid; grid-template-columns: repeat(4, 1fr);
  }
  .feature-strip-item {
    display: flex; flex-direction: column; gap: 4px;
    padding: 26px 32px;
    border-right: 1px solid rgba(255,255,255,0.07);
  }
  .feature-strip-item:last-child { border-right: none; }
  .fs-label {
    font-size: 0.58rem; font-weight: 700;
    letter-spacing: 0.2em; text-transform: uppercase; color: rgba(255,255,255,0.38);
  }
  .fs-value { font-size: 0.9rem; font-weight: 500; }

  /* ── WORK CARDS ── */
  .work { padding: 100px 0; }
  .work-grid {
    display: grid; grid-template-columns: repeat(4, 1fr);
    gap: 1px; background: var(--gray-200); border: 1px solid var(--gray-200);
  }
  .work-card {
    background: var(--white); cursor: pointer;
    transition: background 0.18s; display: flex; flex-direction: column;
  }
  .work-card:hover { background: var(--gray-50); }
  .work-card-img { position: relative; aspect-ratio: 1; overflow: hidden; }
  .work-card-img img {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform 0.5s var(--ease);
  }
  .work-card:hover .work-card-img img { transform: scale(1.05); }
  .work-card-num {
    position: absolute; top: 12px; left: 12px;
    font-size: 0.58rem; font-weight: 700; letter-spacing: 0.14em;
    color: var(--gray-600); background: rgba(255,255,255,0.92);
    padding: 3px 8px;
  }
  .work-card-body {
    padding: 20px 22px 24px;
    border-top: 1px solid var(--gray-200); flex: 1;
  }
  .work-card-body h3 { font-size: 0.98rem; font-weight: 500; letter-spacing: -0.01em; margin-bottom: 6px; }
  .work-card-body p  { font-size: 0.8rem; color: var(--gray-600); margin-bottom: 14px; line-height: 1.55; }
  .work-card-cta {
    font-size: 0.72rem; font-weight: 700; letter-spacing: 0.04em;
    display: inline-flex; align-items: center; gap: 6px;
  }
  .work-card:hover .work-card-cta .arrow { transform: translateX(4px); }

  /* ── STUDIO ── */
  .studio { background: var(--black); color: var(--white); padding: 100px 0; position: relative; overflow: hidden; }
  .studio::before {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background-image: radial-gradient(circle, rgba(255,255,255,0.5) 0.9px, transparent 0.9px);
    background-size: 8rem 8rem; background-attachment: fixed; opacity: 0.32;
  }
  .studio-inner { position: relative; z-index: 1; display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 70px; align-items: center; }
  .studio-lead { color: rgba(255,255,255,0.62); font-size: 1rem; line-height: 1.75; margin-bottom: 36px; max-width: 480px; }
  .studio-mv { display: flex; flex-direction: column; gap: 1px; }
  .mv-card {
    border: 1px solid rgba(255,255,255,0.08); padding: 22px 24px;
    transition: background 0.18s;
  }
  .mv-card + .mv-card { margin-top: 1px; }
  .mv-card:hover { background: rgba(255,255,255,0.04); }
  .mv-label {
    font-size: 0.58rem; font-weight: 700; letter-spacing: 0.2em;
    text-transform: uppercase; color: rgba(255,255,255,0.35);
  }
  .mv-card h4 { font-size: 1rem; font-weight: 500; letter-spacing: -0.01em; margin: 8px 0 8px; }
  .mv-card p  { font-size: 0.84rem; color: rgba(255,255,255,0.58); line-height: 1.65; }
  .studio-visual { position: relative; }
  .studio-img-main { overflow: hidden; aspect-ratio: 4/5; border-radius: var(--r); }
  .studio-img-main img { width: 100%; height: 100%; object-fit: cover; }
  .studio-stats {
    display: flex; gap: 0; margin-top: 1px;
    border: 1px solid rgba(255,255,255,0.08);
  }
  .stat {
    display: flex; flex-direction: column; flex: 1; padding: 20px;
    border-right: 1px solid rgba(255,255,255,0.08);
  }
  .stat:last-child { border-right: none; }
  .stat-n    { font-size: 2.2rem; font-weight: 500; line-height: 1; letter-spacing: -0.04em; display: inline; }
  .stat-plus { font-size: 1.4rem; font-weight: 500; }
  .stat-l    { font-size: 0.6rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(255,255,255,0.38); margin-top: 6px; }

  /* ── SERVICES ── */
  .services { padding: 100px 0; background: var(--gray-50); }
  .services-grid {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: 1px; background: var(--gray-200); border: 1px solid var(--gray-200);
  }
  .service-card { background: var(--white); padding: 36px 30px; transition: background 0.18s, color 0.18s; }
  .service-card:hover { background: var(--black); color: var(--white); }
  .service-num {
    font-size: 0.58rem; font-weight: 700; letter-spacing: 0.2em;
    text-transform: uppercase; color: var(--gray-400);
  }
  .service-card:hover .service-num { color: rgba(255,255,255,0.38); }
  .service-icon-wrap {
    width: 100%; aspect-ratio: 16/9; overflow: hidden;
    margin: 16px 0 20px; border-radius: var(--r);
  }
  .service-icon-wrap img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s; }
  .service-card:hover .service-icon-wrap img { transform: scale(1.04); }
  .service-card h3 { font-size: 1.1rem; font-weight: 500; letter-spacing: -0.01em; margin-bottom: 12px; }
  .service-card p  { font-size: 0.84rem; color: var(--gray-600); line-height: 1.7; }
  .service-card:hover p { color: rgba(255,255,255,0.65); }

  /* ── HIGHLIGHT ── */
  .highlight { padding: 100px 0; }
  .highlight-inner { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: center; }
  .highlight-img {
    overflow: hidden; aspect-ratio: 5/4;
    border-radius: var(--r); border: 1px solid var(--gray-200);
  }
  .highlight-img img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s var(--ease); }
  .highlight-img:hover img { transform: scale(1.03); }
  .highlight-copy { max-width: 480px; }
  .highlight-desc { color: var(--gray-600); font-size: 1rem; line-height: 1.72; margin: 18px 0 28px; }

  /* ── JOURNAL ── */
  .journal { padding: 100px 0; background: var(--gray-50); }
  .journal-grid {
    display: grid; grid-template-columns: repeat(2, 1fr);
    gap: 1px; background: var(--gray-200); border: 1px solid var(--gray-200);
  }
  .journal-card {
    background: var(--white); display: flex; flex-direction: column;
    transition: background 0.18s; cursor: pointer;
  }
  .journal-card:hover { background: var(--gray-50); }
  .journal-card-img { aspect-ratio: 16/9; overflow: hidden; }
  .journal-card-img img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s; }
  .journal-card:hover .journal-card-img img { transform: scale(1.04); }
  .journal-card-body { padding: 26px 28px 30px; border-top: 1px solid var(--gray-200); flex: 1; }
  .journal-date {
    font-size: 0.62rem; font-weight: 700; letter-spacing: 0.12em;
    text-transform: uppercase; color: var(--gray-400);
  }
  .journal-card-body h3 {
    font-size: 1.1rem; font-weight: 500; letter-spacing: -0.01em;
    margin: 10px 0 10px; line-height: 1.22;
  }
  .journal-card-body p  { font-size: 0.84rem; color: var(--gray-600); line-height: 1.65; margin-bottom: 16px; }
  .journal-cta { font-size: 0.72rem; font-weight: 700; display: inline-flex; align-items: center; gap: 6px; letter-spacing: 0.04em; }
  .journal-card:hover .journal-cta .arrow { transform: translateX(4px); }

  /* ── CTA ── */
  .cta { background: var(--black); color: var(--white); padding: 120px 0; text-align: center; position: relative; overflow: hidden; }
  .cta::before {
    content: ''; position: absolute; inset: 0;
    background-image: radial-gradient(circle, rgba(255,255,255,0.5) 0.9px, transparent 0.9px);
    background-size: 8rem 8rem; background-attachment: fixed; opacity: 0.32;
  }
  .cta-inner { position: relative; max-width: 600px; margin: 0 auto; }
  .cta-title {
    font-size: clamp(2.4rem, 6vw, 4.4rem);
    font-weight: 500; line-height: 0.94;
    letter-spacing: -0.045em; margin: 8px 0 18px;
  }
  .cta-desc { color: rgba(255,255,255,0.5); font-size: 0.98rem; margin-bottom: 36px; }
  .cta-actions { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; margin-bottom: 40px; }
  .cta-socials { display: flex; gap: 8px; justify-content: center; }
  .cta-socials a {
    width: 40px; height: 40px; border-radius: var(--r);
    border: 1px solid rgba(255,255,255,0.14);
    display: grid; place-items: center; transition: all 0.18s;
  }
  .cta-socials a:hover { background: var(--white); border-color: var(--white); }
  .cta-socials img { width: 16px; height: 16px; filter: brightness(0) invert(1); transition: filter 0.18s; }
  .cta-socials a:hover img { filter: none; }

  /* ── PANEL ── */
  .panel-backdrop {
    position: fixed; inset: 0; z-index: 200;
    background: rgba(0,0,0,0.6); backdrop-filter: blur(3px);
    opacity: 0; visibility: hidden; transition: all 0.3s;
  }
  .panel-backdrop.is-open { opacity: 1; visibility: visible; }
  .panel {
    position: fixed; top: 0; left: 0; right: 0; z-index: 210;
    background: var(--white); border-bottom: 1px solid var(--gray-200);
    max-height: 86vh; overflow-y: auto;
    transform: translateY(-102%);
    transition: transform 0.4s var(--ease-out);
  }
  .panel.is-open { transform: translateY(0); }
  .panel-close {
    position: absolute; top: 20px; right: 24px;
    width: 36px; height: 36px; border-radius: var(--r);
    border: 1px solid var(--gray-200);
    display: grid; place-items: center;
    font-size: 0.88rem; z-index: 5; transition: all 0.18s;
  }
  .panel-close:hover { background: var(--black); color: var(--white); border-color: var(--black); }
  .panel-inner { max-width: var(--maxw); margin: 0 auto; padding: 52px 32px 60px; }
  :global(.panel-tag) {
    font-size: 0.6rem; font-weight: 700; letter-spacing: 0.2em;
    text-transform: uppercase; color: var(--gray-400); margin-bottom: 12px; display: block;
  }
  .panel-inner h2 { font-size: clamp(1.8rem, 3.5vw, 2.8rem); font-weight: 500; letter-spacing: -0.035em; margin-bottom: 16px; }
  .panel-inner > p { color: var(--gray-600); font-size: 0.98rem; line-height: 1.7; max-width: 520px; margin-bottom: 36px; }
  :global(.panel-grid) {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: 1px; background: var(--gray-200); border: 1px solid var(--gray-200);
  }
  :global(.panel-card) {
    background: var(--white); padding: 32px 28px;
    display: flex; flex-direction: column; gap: 10px;
    transition: background 0.18s, color 0.18s;
  }
  :global(.panel-card:hover) { background: var(--black); color: var(--white); }
  :global(.panel-card--link) { cursor: pointer; }
  :global(.pc-num) { font-size: 0.6rem; font-weight: 700; letter-spacing: 0.12em; color: var(--gray-400); }
  :global(.panel-card:hover .pc-num) { color: rgba(255,255,255,0.35); }
  :global(.panel-card h4) { font-size: 1.05rem; font-weight: 500; letter-spacing: -0.015em; line-height: 1.25; }
  :global(.panel-card p)  { font-size: 0.85rem; color: var(--gray-600); line-height: 1.7; flex: 1; }
  :global(.panel-card:hover p) { color: rgba(255,255,255,0.62); }
  :global(.pc-link) {
    margin-top: 8px; font-size: 0.7rem; font-weight: 700; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--gray-400);
  }
  :global(.panel-card:hover .pc-link) { color: rgba(255,255,255,0.55); }

  /* ── RESPONSIVE (homepage-specific) ── */
  @media (max-width: 1024px) {
    .work-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 900px) {
    .hero-inner { grid-template-columns: 1fr; gap: 48px; }
    .hero-visual { max-width: 400px; }
    .studio-inner { grid-template-columns: 1fr; gap: 48px; }
    .highlight-inner { grid-template-columns: 1fr; gap: 40px; }
    :global(.panel-grid) { grid-template-columns: 1fr; }
    .feature-strip-inner { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 700px) {
    .work-grid { grid-template-columns: 1fr 1fr; }
    .services-grid { grid-template-columns: 1fr; }
    .journal-grid { grid-template-columns: 1fr; }
    .hero-badge { display: none; }
    .scroll-cue { display: none; }
  }
</style>

<script is:inline define:vars={{ journalPanelCards }}>
  const $ = (s, el = document) => el.querySelector(s);
  const $$ = (s, el = document) => [...el.querySelectorAll(s)];

  /* Scroll reveal */
  const revealObs = new IntersectionObserver((entries) => {
    entries.forEach((entry, i) => {
      if (entry.isIntersecting) {
        setTimeout(() => entry.target.classList.add('is-visible'), (i % 5) * 80);
        revealObs.unobserve(entry.target);
      }
    });
  }, { threshold: 0.1 });
  $$('.reveal').forEach((el) => revealObs.observe(el));

  /* Stat counters */
  function animateCount(el) {
    const target = +el.dataset.target;
    const dur = 1500;
    const start = performance.now();
    function tick(now) {
      const p = Math.min((now - start) / dur, 1);
      const eased = 1 - Math.pow(1 - p, 3);
      el.textContent = Math.floor(eased * target);
      if (p < 1) requestAnimationFrame(tick);
      else el.textContent = target;
    }
    requestAnimationFrame(tick);
  }
  const countObs = new IntersectionObserver((entries) => {
    entries.forEach((e) => { if (e.isIntersecting) { animateCount(e.target); countObs.unobserve(e.target); } });
  }, { threshold: 0.5 });
  $$('.stat-n').forEach((el) => countObs.observe(el));

  /* Panel */
  const PANEL_DATA = {
    studio: {
      tag: 'The studio', title: 'About SND',
      body: 'We turn ideas into reality through thoughtful design, innovative development, and genuine collaboration. SND builds intelligent, creative, and culturally relevant solutions.',
      cards: [
        { num: '01', h: 'Technology', p: 'Building applications, tools, and platforms designed to solve real-world problems. Scalable digital systems with long-term usability.' },
        { num: '02', h: 'Art & Design', p: 'Visual identity systems, interfaces, motion graphics, and brand experiences that combine clarity with aesthetics.' },
        { num: '03', h: 'Fashion & Physical Goods', p: 'Thoughtfully designed merchandise and physical products that increase visibility and strengthen identity.' },
      ],
    },
    services: {
      tag: 'Services', title: 'Design & Creative',
      body: 'Interfaces designed for humans first: intuitive, accessible, and built to serve a clear purpose on every screen.',
      cards: [
        { num: '01', h: 'Branding', p: 'Visual identity systems, logos, and brand experiences that communicate clearly and build lasting recognition.' },
        { num: '02', h: 'UI / UX', p: 'Interfaces designed for humans first: intuitive, accessible, and built to serve a clear purpose on every screen.' },
        { num: '03', h: 'Motion', p: 'Bring ideas to life through animation, motion graphics, and dynamic storytelling that captures attention.' },
      ],
    },
    products: {
      tag: 'Physical Goods', title: 'Products',
      body: 'The SND ecosystem in physical form. Thoughtfully designed objects that extend the studio identity into the world.',
      cards: [
        { num: '01', h: 'Notebooks', p: 'Crafted for thinkers and makers. Clean layouts and quality materials that make the act of writing feel considered.' },
        { num: '02', h: 'Apparel', p: 'Wear the brand. Minimal pieces that carry the SND aesthetic, designed to be worn, not just seen.' },
        { num: '03', h: 'Merchandise', p: 'Objects that extend the studio identity into the physical world and create touchpoints beyond the screen.' },
      ],
    },
    journal: {
      tag: 'Blog', title: 'The Journal',
      body: 'Stories, ideas, and perspectives from the SND team on design, technology, culture, and the process of building things that matter.',
      cards: journalPanelCards,
    },
  };

  const panel = $('#panel');
  const panelBackdrop = $('#panelBackdrop');
  const panelInner = $('#panelInner');
  const panelClose = $('#panelClose');
  let lastFocused = null;

  function openPanel(key, trigger) {
    const data = PANEL_DATA[key];
    if (!data) return;
    lastFocused = trigger || document.activeElement;
    panelInner.innerHTML = `
      <span class="panel-tag">${data.tag}</span>
      <h2>${data.title}</h2>
      <p>${data.body}</p>
      <div class="panel-grid">
        ${data.cards.map((c) => `
          <div class="panel-card ${c.href ? 'panel-card--link' : ''}" ${c.href ? `data-href="${c.href}"` : ''}>
            <div class="pc-num">${c.num}</div>
            <h4>${c.h}</h4>
            <p>${c.p}</p>
            ${c.href ? '<span class="pc-link">Read article &rarr;</span>' : ''}
          </div>`).join('')}
      </div>`;
    $$('.panel-card--link', panelInner).forEach((card) => {
      card.style.cursor = 'pointer';
      card.addEventListener('click', () => { window.location.href = card.dataset.href; });
    });
    panel.classList.add('is-open');
    panelBackdrop.classList.add('is-open');
    panel.scrollTop = 0;
    document.body.style.overflow = 'hidden';
    panelClose?.focus();
  }

  function closePanel() {
    if (!panel.classList.contains('is-open')) return;
    panel.classList.remove('is-open');
    panelBackdrop.classList.remove('is-open');
    document.body.style.overflow = '';
    if (lastFocused) { lastFocused.focus(); lastFocused = null; }
  }

  /* Work cards: clickable + keyboard-operable (Enter / Space) */
  $$('.work-card').forEach((card) => {
    card.setAttribute('role', 'button');
    card.setAttribute('tabindex', '0');
    const open = () => openPanel(card.dataset.panel, card);
    card.addEventListener('click', open);
    card.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(); }
    });
  });
  panelClose?.addEventListener('click', closePanel);
  panelBackdrop?.addEventListener('click', closePanel);
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closePanel(); });

  /* Smooth anchor scroll */
  $$('a[href^="#"]').forEach((a) => {
    a.addEventListener('click', (e) => {
      const id = a.getAttribute('href');
      if (id.length < 2) return;
      const target = document.querySelector(id);
      if (!target) return;
      e.preventDefault();
      const top = target.getBoundingClientRect().top + window.scrollY - 70;
      window.scrollTo({ top, behavior: 'smooth' });
    });
  });
</script>

</BaseLayout>
