<script>
(function () {
  const cards = Array.from(document.querySelectorAll<HTMLElement>('#cardsGrid .card'));
  const canvasWrap = document.querySelector<HTMLElement>('.canvas-wrap');

  if (!cards.length || window.innerWidth <= 768 || !canvasWrap) return;

  let dragCard: HTMLElement | null = null;
  let dragOffsetX = 0;
  let dragOffsetY = 0;
  let dragStartX = 0;
  let dragStartY = 0;
  let hasDragged = false;

  cards.forEach((card) => {
    card.addEventListener('mousedown', (e: MouseEvent) => {
      if (e.button !== 0) return;

      const rect = card.getBoundingClientRect();
      const canvasRect = canvasWrap.getBoundingClientRect();

      dragCard   = card;
      dragStartX = e.clientX;
      dragStartY = e.clientY;
      hasDragged = false;

      dragOffsetX = e.clientX - (rect.left + rect.width  / 2);
      dragOffsetY = e.clientY - (rect.top  + rect.height / 2);

      card.style.left = (rect.left + rect.width  / 2 - canvasRect.left) + 'px';
      card.style.top  = (rect.top  + rect.height / 2 - canvasRect.top)  + 'px';

      e.preventDefault();
    });
  });

  document.addEventListener('mousemove', (e: MouseEvent) => {
    if (!dragCard) return;

    const dx = e.clientX - dragStartX;
    const dy = e.clientY - dragStartY;

    if (!hasDragged && Math.sqrt(dx * dx + dy * dy) < 5) return;
    hasDragged = true;

    dragCard.classList.add('dragging');

    const canvasRect = canvasWrap.getBoundingClientRect();
    dragCard.style.left = (e.clientX - dragOffsetX - canvasRect.left) + 'px';
    dragCard.style.top  = (e.clientY - dragOffsetY - canvasRect.top)  + 'px';
  });

  document.addEventListener('mouseup', () => {
    if (!dragCard) return;

    if (hasDragged) {
      const captured = dragCard;
      const blockClick = (ev: Event) => {
        ev.preventDefault();
        ev.stopPropagation();
        captured.removeEventListener('click', blockClick, true);
      };
      dragCard.addEventListener('click', blockClick, true);
    }

    dragCard.classList.remove('dragging');
    dragCard = null;
    hasDragged = false;
  });
})();
</script>

<script>
(function () {
  const panel    = document.getElementById('infoPanel')     as HTMLElement;
  const backdrop = document.getElementById('panelBackdrop') as HTMLElement;
  const closeBtn = document.getElementById('panelClose')    as HTMLButtonElement;

  if (!panel || !backdrop) return;

  function openPanel(id: string) {
    panel.querySelectorAll<HTMLElement>('.panel-content').forEach(el => el.classList.remove('active'));
    const target = panel.querySelector<HTMLElement>(`.panel-content[data-panel="${id}"]`);
    if (!target) return;
    target.classList.add('active');
    panel.classList.add('open');
    backdrop.classList.add('active');
    panel.scrollTop = 0;
  }

  function closePanel() {
    panel.classList.remove('open');
    backdrop.classList.remove('active');
  }

  document.querySelectorAll<HTMLElement>('#cardsGrid .card[data-panel]').forEach(card => {
    card.addEventListener('click', () => {
      const id = card.dataset.panel;
      if (id) openPanel(id);
    });
  });

  closeBtn?.addEventListener('click', closePanel);
  backdrop.addEventListener('click', closePanel);
  document.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'Escape') closePanel();
  });
})();
</script>

<script>
(function () {
  const video  = document.getElementById('logoVideo')  as HTMLVideoElement;
  const canvas = document.getElementById('logoCanvas') as HTMLCanvasElement;
  if (!video || !canvas) return;

  const ctx = canvas.getContext('2d') as CanvasRenderingContext2D;
  if (!ctx) return;

  const DISPLAY_H = 520;
  let ready = false;

  function setup() {
    if (ready || !video.videoWidth) return;
    ready = true;
    const aspect = video.videoWidth / video.videoHeight;
    canvas.width  = video.videoWidth;
    canvas.height = video.videoHeight;
    canvas.style.height = DISPLAY_H + 'px';
    canvas.style.width  = Math.round(DISPLAY_H * aspect) + 'px';
  }

  function drawFrame(): void {
    if (video.readyState >= 2) {
      if (!ready) setup();
      if (ready) {
        ctx.drawImage(video, 0, 0, canvas.width, canvas.height);
        const img = ctx.getImageData(0, 0, canvas.width, canvas.height);
        const d = img.data;
        for (let i = 0; i < d.length; i += 4) {
          if (d[i] > 230 && d[i + 1] > 230 && d[i + 2] > 230) d[i + 3] = 0;
        }
        ctx.putImageData(img, 0, 0);
      }
    }
    requestAnimationFrame(drawFrame);
  }

  video.addEventListener('ended', () => {
    setTimeout(() => { video.play().catch(() => {}); }, 10000);
  });

  video.play().catch(() => {});
  requestAnimationFrame(drawFrame);
})();
</script>

<script>
(function () {
  const el = document.getElementById('typewriterText') as HTMLElement | null;
  if (!el) return;
  const span = el;

  const lines = [
    "Think It. Create It.",
    "A creative studio from Uganda.",
    "Building intelligent, creative, and culturally relevant solutions.",
    "Technology · Art & Design · Physical Goods.",
    "10+ projects completed.",
    "15+ happy clients.",
    "Simplifying complex problems through thoughtful design.",
    "World-class digital products originating from Uganda.",
    "Every product must serve a clear purpose.",
    "Design · Development · Physical Goods.",
    "3+ years of building things that matter.",
  ];

  let lineIndex = 0;
  let charIndex = 0;
  let deleting = false;

  function tick() {
    const current = lines[lineIndex];

    if (deleting) {
      charIndex--;
      span.textContent = current.slice(0, charIndex);
      if (charIndex === 0) {
        deleting = false;
        lineIndex = (lineIndex + 1) % lines.length;
        setTimeout(tick, 480);
      } else {
        setTimeout(tick, 22);
      }
    } else {
      charIndex++;
      span.textContent = current.slice(0, charIndex);
      if (charIndex === current.length) {
        setTimeout(() => { deleting = true; tick(); }, 2800);
      } else {
        setTimeout(tick, 52);
      }
    }
  }

  setTimeout(tick, 900);
})();
</script>

