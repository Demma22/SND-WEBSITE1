---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.md$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const postExists = !!post;

const rendered = postExists ? await render(post) : null;
const ContentComponent = rendered?.Content;
---

<BaseLayout title={postExists ? `${post.data.title} — SND Journal` : 'Not Found — SND'}>

<Header active="Journal" />

<main id="main" tabindex="-1">

{!postExists ? (
  <div class="not-found">
    <span class="eyebrow">404</span>
    <h1>Post not found</h1>
    <p>The article you're looking for doesn't exist or has been moved.</p>
    <a href="/blog" class="btn btn--dark">Back to Journal</a>
  </div>
) : (
  <>
    <!-- ── POST HERO ── -->
    <section class="post-hero">
      <div class="hero-bg"></div>
      <div class="container post-hero-inner">
        <a href="/blog" class="back-link">&larr; Journal</a>
        {post.data.tags && (
          <div class="tag-row">
            {post.data.tags.slice(0, 3).map((tag: string) => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        )}
        <h1 class="post-title">{post.data.title}</h1>
        <p class="post-desc">{post.data.description}</p>
        <span class="eyebrow">{post.data.pubDate} &middot; {post.data.author}</span>
      </div>
    </section>

    <!-- ── HERO IMAGE ── -->
    {post.data.image && (
      <div class="post-cover">
        <div class="container">
          <img src={post.data.image} alt="" />
        </div>
      </div>
    )}

    <!-- ── ARTICLE ── -->
    <article class="post-body">
      <div class="container">
        <div class="prose">
          {ContentComponent && <ContentComponent />}
        </div>
      </div>
    </article>

    <!-- ── BOTTOM NAV ── -->
    <div class="post-nav">
      <div class="container">
        <a href="/blog" class="btn btn--ghost">&larr; All articles</a>
        <a href="/#contact" class="btn btn--dark">Start a project &rarr;</a>
      </div>
    </div>
  </>
)}

</main>

<Footer />

</BaseLayout>

<style>
  /* Tokens, header, buttons & eyebrow are global (app.css). */
  :root { --prose-w: 720px; }

  /* ── POST HERO ── */
  .post-hero { position: relative; padding: calc(var(--header-h) + 72px) 0 64px; overflow: hidden; }
  .post-hero .hero-bg {
    position: absolute; inset: 0; z-index: 0;
    background-image: radial-gradient(circle, rgba(0,0,0,0.5) 0.9px, transparent 0.9px);
    background-size: 8rem 8rem; opacity: 0.06;
  }
  .post-hero-inner { position: relative; z-index: 1; max-width: var(--prose-w); }
  .back-link {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: 0.72rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--gray-400); text-decoration: none; margin-bottom: 24px;
    transition: color 0.15s;
  }
  .back-link:hover { color: var(--black); }
  .tag-row { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 20px; }
  .tag {
    font-size: 0.6rem; font-weight: 600; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--gray-600);
    border: 1px solid var(--gray-200); padding: 3px 8px; border-radius: var(--r);
  }
  .post-title {
    font-size: clamp(2rem, 4.5vw, 3.2rem); font-weight: 500;
    letter-spacing: -0.04em; line-height: 1.1; margin-bottom: 20px;
  }
  .post-desc { font-size: 1.05rem; color: var(--gray-600); line-height: 1.7; margin-bottom: 28px; }

  /* ── COVER IMAGE ── */
  .post-cover { padding: 0 0 60px; }
  .post-cover img {
    width: 100%; max-height: 480px; object-fit: cover;
    border-radius: var(--r); display: block; border: 1px solid var(--gray-200);
  }

  /* ── PROSE ── */
  .post-body { padding-bottom: 80px; }
  .prose { max-width: var(--prose-w); }
  .prose :global(h2) { font-size: 1.6rem; font-weight: 500; letter-spacing: -0.03em; margin: 2.5rem 0 1rem; line-height: 1.2; }
  .prose :global(h3) { font-size: 1.2rem; font-weight: 500; letter-spacing: -0.02em; margin: 2rem 0 0.75rem; line-height: 1.3; }
  .prose :global(h4) { font-size: 0.9rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--gray-600); margin: 1.75rem 0 0.5rem; }
  .prose :global(p)  { font-size: 1rem; color: var(--gray-600); line-height: 1.8; margin-bottom: 1.25rem; }
  .prose :global(ul), .prose :global(ol) { padding-left: 1.5rem; color: var(--gray-600); font-size: 1rem; line-height: 1.8; margin-bottom: 1.25rem; }
  .prose :global(li) { margin-bottom: 0.4rem; }
  .prose :global(strong) { color: var(--black); font-weight: 600; }
  .prose :global(em) { font-style: italic; }
  .prose :global(a) { color: var(--black); text-decoration: underline; text-underline-offset: 3px; }
  .prose :global(a:hover) { opacity: 0.7; }
  .prose :global(blockquote) { border-left: 2px solid var(--black); padding-left: 20px; margin: 2rem 0; color: var(--gray-600); font-style: italic; }
  .prose :global(code) { font-size: 0.85em; background: var(--gray-100); padding: 2px 6px; border-radius: var(--r); font-family: 'JetBrains Mono', 'Fira Code', monospace; }
  .prose :global(pre) { background: var(--gray-900); color: var(--gray-100); padding: 24px; border-radius: var(--r); overflow-x: auto; margin: 1.5rem 0; font-size: 0.85rem; line-height: 1.7; }
  .prose :global(pre code) { background: none; padding: 0; }
  .prose :global(hr) { border: none; border-top: 1px solid var(--gray-200); margin: 2.5rem 0; }
  .prose :global(img) { width: 100%; border-radius: var(--r); margin: 1.5rem 0; border: 1px solid var(--gray-200); }

  /* ── BOTTOM NAV ── */
  .post-nav { border-top: 1px solid var(--gray-200); padding: 32px 0; }
  .post-nav .container { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }

  /* ── 404 ── */
  .not-found { padding: calc(var(--header-h) + 120px) 32px 120px; max-width: var(--prose-w); margin: 0 auto; }
  .not-found h1 { font-size: 2.4rem; font-weight: 500; letter-spacing: -0.04em; margin-bottom: 12px; }
  .not-found p  { color: var(--gray-600); margin-bottom: 32px; }

  /* ── RESPONSIVE ── */
  @media (max-width: 700px) {
    .post-hero { padding-bottom: 40px; }
    .post-nav .container { flex-direction: column; align-items: flex-start; }
  }
</style>
