---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { WHATSAPP } from '../lib/site';
import { getRates, formatMoney, DEFAULT_CURRENCY } from '../lib/money';

/* The notebook is priced locally, in UGX — that round number is the real
   price, so it stays authored here. Only the USD conversion needs a rate, and
   that now comes from the shared live table (it was hardcoded at 3800, which
   had drifted ~5% out of date). */
const rates = await getRates();
const UGX_PER_USD = rates.UGX;

/* Render the opening price in the site default so there is no flash of the
   wrong currency before the header selector's choice is applied — and so the
   page still shows a correct price with JavaScript off. */
const PRICE_UGX = 30000;
const initialPrice = formatMoney(PRICE_UGX / UGX_PER_USD, DEFAULT_CURRENCY, rates, { UGX: PRICE_UGX });
---

<BaseLayout title="Products — SND">

<Header active="Products" />

<main id="main" tabindex="-1">

<!-- ── HERO ── -->
<section class="page-hero">
  <div class="hero-bg"></div>
  <div class="container page-hero-inner">
    <span class="eyebrow">Physical Goods</span>
    <h1 class="hero-title">Products.</h1>
    <p class="hero-sub">Thoughtfully designed objects that extend the studio into the physical world. Available now, with more on the way.</p>
  </div>
</section>

<!-- ── PRODUCT ── -->
<section class="product">
  <div class="container product-grid">
    <div class="product-media reveal">
      <img src="/notebook.jpeg" alt="Lineless Pocket Notebook" fetchpriority="high" decoding="async" />
      <span class="product-tag">01 / Notebook</span>
    </div>

    <div class="product-info reveal">
      <span class="eyebrow">Lineless Pocket Notebook &middot; In stock</span>
      <h2 class="product-title">Lineless Pocket Notebook.</h2>
      <p class="product-desc">
        Somewhere to journal your thoughts, map out plans, and track your progress,
        then turn the page over to sketching and drawing. No lines. No rules.
      </p>

      <!-- Price. Currency is set site-wide from the header selector. -->
      <div class="price-row">
        <span class="price price--lg" id="priceVal" aria-live="polite">{initialPrice}</span>
      </div>

      <!-- Buy controls -->
      <div class="buy-row">
        <div class="qty" role="group" aria-label="Quantity">
          <button type="button" id="qtyMinus" aria-label="Decrease quantity">&minus;</button>
          <span id="qtyVal" aria-live="polite">1</span>
          <button type="button" id="qtyPlus" aria-label="Increase quantity">&plus;</button>
        </div>
        <a id="orderBtn" class="btn btn--dark" target="_blank" rel="noopener" href="#">
          Order on WhatsApp <span class="arrow">&#8594;</span>
        </a>
      </div>
      <p class="buy-note">Orders are confirmed over WhatsApp, we'll share availability and delivery.</p>
    </div>
  </div>
</section>

<!-- ── COMING SOON ── -->
<section class="more">
  <div class="container">
    <div class="more-card">
      <span class="eyebrow">Apparel &amp; Merch</span>
      <h3>More products coming soon.</h3>
    </div>
  </div>
</section>

</main>

<Footer />

</BaseLayout>

<style>
  /* Tokens, header, buttons, eyebrow & page-hero are global (app.css). */

  .product { padding: 80px 0 100px; }
  .product-grid {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 64px; align-items: center;
  }
  .product-media {
    position: relative; overflow: hidden;
    aspect-ratio: 4/5; max-width: 340px; width: 100%; justify-self: center;
    border-radius: var(--r); border: 1px solid var(--gray-200);
  }
  .product-media img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s var(--ease); }
  .product-media:hover img { transform: scale(1.03); }
  .product-tag {
    position: absolute; top: 14px; left: 14px;
    font-size: 0.58rem; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--black); background: rgba(255,255,255,0.92); padding: 4px 10px; border-radius: var(--r);
  }

  .product-info { max-width: 480px; }
  .product-title { font-size: clamp(1.9rem, 3.5vw, 2.8rem); font-weight: 500; letter-spacing: -0.035em; line-height: 1.05; margin-bottom: 18px; }
  .product-desc { color: var(--gray-600); font-size: 1rem; line-height: 1.75; margin-bottom: 32px; }

  /* Price */
  .price-row { display: flex; align-items: center; gap: 16px; margin-bottom: 22px; flex-wrap: wrap; }
  .price { font-size: 1.5rem; font-weight: 500; letter-spacing: -0.02em; }
  /* Buy controls */
  .buy-row { display: flex; align-items: stretch; gap: 12px; flex-wrap: wrap; }
  .qty {
    display: inline-flex; align-items: center;
    border: 1px solid var(--black); border-radius: var(--r);
  }
  .qty button {
    width: 40px; height: 100%; min-height: 42px;
    font-size: 1.1rem; line-height: 1; color: var(--black);
    transition: background 0.15s, color 0.15s;
  }
  .qty button:hover { background: var(--black); color: var(--white); }
  .qty #qtyVal {
    min-width: 44px; text-align: center; font-size: 0.95rem; font-weight: 500;
    border-left: 1px solid var(--gray-200); border-right: 1px solid var(--gray-200);
    padding: 0 6px; align-self: stretch; display: grid; place-items: center;
  }

  .buy-note { margin-top: 14px; font-size: 0.76rem; color: var(--gray-400); line-height: 1.5; }

  /* Coming soon */
  .more { padding: 0 0 100px; }
  .more-card {
    border: 1px solid var(--gray-200); border-radius: var(--r);
    padding: 48px 40px; text-align: center;
  }
  .more-card h3 { font-size: 1.5rem; font-weight: 500; letter-spacing: -0.025em; margin-bottom: 10px; }
  .more-card p  { color: var(--gray-600); font-size: 0.92rem; max-width: 440px; margin: 0 auto; line-height: 1.7; }

  @media (max-width: 900px) {
    .product-grid { grid-template-columns: 1fr; gap: 40px; }
    .product-media { max-width: 460px; }
  }
  @media (max-width: 700px) {
    .product { padding: 56px 0 72px; }
    .page-hero { padding-bottom: 48px; }
  }
</style>

<script is:inline data-astro-rerun define:vars={{ WHATSAPP, UGX_PER_USD }}>
  (function () {
    /* The notebook is priced locally: 30,000 UGX is the real figure, so it is
       shown verbatim to UGX visitors and every other currency is derived from
       the USD pivot — the same rule the artwork pages follow.

       Currency itself comes from the header selector, broadcast by
       CurrencyEngine as `snd:currency`. That event always fires on load, so
       this never has to guess which currency to start in. */
    const PRICE_UGX = 30000;
    const UNIT_USD  = PRICE_UGX / UGX_PER_USD;

    let qty = 1;
    let money = null;   // set by the first snd:currency event

    const qtyVal   = document.getElementById('qtyVal');
    const minus    = document.getElementById('qtyMinus');
    const plus     = document.getElementById('qtyPlus');
    const orderBtn = document.getElementById('orderBtn');
    const priceVal = document.getElementById('priceVal');

    const totalLabel = (q) =>
      money
        ? money.format(UNIT_USD * q, { UGX: PRICE_UGX * q })
        : 'USh' + (PRICE_UGX * q).toLocaleString('en-US');

    function orderLink(q) {
      const plural = q > 1 ? 's' : '';
      const msg =
        `Hi SND! I would like to purchase ${q} Lineless Pocket Notebook${plural} ` +
        `(total ${totalLabel(q)}). ` +
        `Could you please confirm availability and delivery details? Thank you.`;
      return `https://wa.me/${WHATSAPP}?text=${encodeURIComponent(msg)}`;
    }

    function render() {
      qtyVal.textContent = String(qty);
      priceVal.textContent = totalLabel(qty);   // running total grows with quantity
      orderBtn.href = orderLink(qty);
    }

    minus.addEventListener('click', () => { qty = Math.max(1, qty - 1); render(); });
    plus.addEventListener('click',  () => { qty = Math.min(99, qty + 1); render(); });

    document.addEventListener('snd:currency', (e) => { money = e.detail; render(); });

    render(); // initialise before the first event lands
  })();
</script>
